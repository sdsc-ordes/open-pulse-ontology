@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix ex:     <http://example.org/> .
@prefix pulse:  <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# ---------------------------------------------------------
# 1. CLASS & PROPERTY SECTION
# ---------------------------------------------------------
<https://open-pulse.epfl.ch/ontology#> a owl:Ontology ;
    dct:abstract "The Open Pulse Ontology to model contributions to open source scientific software and research articles from EPFL." ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    dct:title "Open Pulse Ontology" ;
    owl:versionInfo "v.2.0"^^xsd:string .

# Classes
schema:Person a rdfs:Class ; rdfs:label "Person" ; rdfs:comment "An individual researcher or contributor." .
schema:ScholarlyArticle a rdfs:Class ; rdfs:label "Scholarly Article" ; rdfs:comment "A research paper or publication." .
schema:SoftwareSourceCode a rdfs:Class ; rdfs:label "Software Repository" ; rdfs:comment "A software project or source code." .
schema:Dataset a rdfs:Class ; rdfs:label "Dataset" ; rdfs:comment "Data collections used or generated by research software." .
org:Membership a rdfs:Class ; rdfs:label "Membership" ; rdfs:comment "A affiliation between a Person and an Organization." .
org:Organization a rdfs:Class ; rdfs:label "Organization" ; rdfs:comment "A research center, university, or lab." .
ex:GitCommit a rdfs:Class ; rdfs:label "Git Commit" ; rdfs:comment "A specific record of changes in a software repository." .

# Enumeration Classes
schema:Enumeration a rdfs:Class ; rdfs:label "Enumeration" .
ex:DisciplineEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; rdfs:label "Discipline Enumeration" .
ex:RepositoryTypeEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; rdfs:label "Repository Type Enumeration" .
ex:OrganizationTypeEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; rdfs:label "Organization Type Enumeration" .

# Enumeration Instances - Repository Types
ex:Software a ex:RepositoryTypeEnumeration ; rdfs:label "Software" ; rdfs:comment "A repository that contains software source code." .
ex:EducationalResource a ex:RepositoryTypeEnumeration ; rdfs:label "Educational Resource" ; rdfs:comment "A repository that contains educational materials." .
ex:Documentation a ex:RepositoryTypeEnumeration ; rdfs:label "Documentation" ; rdfs:comment "A repository that contains documentation." .
ex:Data a ex:RepositoryTypeEnumeration ; rdfs:label "Data" ; rdfs:comment "A repository that contains datasets." .
ex:Other a ex:RepositoryTypeEnumeration ; rdfs:label "Other" ; rdfs:comment "A repository that does not fit into the other categories." .

# Enumeration Instances - Organization Types
ex:University a ex:OrganizationTypeEnumeration ; rdfs:label "University" ; rdfs:comment "An educational institution." .
ex:ResearchInstitution a ex:OrganizationTypeEnumeration ; rdfs:label "Research Institution" ; rdfs:comment "a research institution is one that has made conducting research a vital part of its mission and goals." .
ex:GovernmentAgency a ex:OrganizationTypeEnumeration ; rdfs:label "Government Agency" ; rdfs:comment "A government organization." .
ex:SoftwareProject a ex:OrganizationTypeEnumeration ; rdfs:label "Software Project" ; rdfs:comment "An organization focused on development of specific software." .
ex:PrivateCompany a ex:OrganizationTypeEnumeration ; rdfs:label "Private Company" ; rdfs:comment "A privately owned business organization." .
ex:NonProfitOrganization a ex:OrganizationTypeEnumeration ; rdfs:label "Non-Profit Organization" ; rdfs:comment "An organization that operates for a charitable or social purpose rather than for profit." .
ex:CommunitySpace a ex:OrganizationTypeEnumeration ; rdfs:label "Community Space" ; rdfs:comment "A community-driven organization or space." .
ex:OtherOrganizationType a ex:OrganizationTypeEnumeration ; rdfs:label "Other" ; rdfs:comment "An organization type that does not fit into the other categories." .

# Enumeration Instances - Disciplines
wd:Q34749 a ex:DisciplineEnumeration; rdfs:label "Social sciences"@en; rdfs:subClassOf wd:Q11862829 .
wd:Q23404 a ex:DisciplineEnumeration; rdfs:label "Anthropology"@en; rdfs:subClassOf wd:Q34749 .
