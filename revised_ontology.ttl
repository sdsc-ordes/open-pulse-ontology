# Properties
schema:name a rdfs:Property ; rdfs:label "name"; rdfs:comment "The name of the item." .
schema:email a rdfs:Property ; rdfs:label "email" ; rdfs:comment "Email address." .
schema:url a rdfs:Property ; rdfs:label "url" ; rdfs:comment "	URL of the item." .
schema:identifier a rdfs:Property ; rdfs:label "identifier" ; rdfs:comment "The identifier (URL/Text) property represents any kind of identifier for any kind of Thing" .
schema:creator a rdfs:Property ; rdfs:label "creator" ; rdfs:comment "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." .
schema:headline a rdfs:Property ; rdfs:label "headline" ; rdfs:comment "The headline of the article." .
schema:gender a rdfs:Property ; rdfs:label "gender" ; rdfs:comment "The gender of the person." .
schema:programmingLanguage a rdfs:Property ; rdfs:label "programming language" ; rdfs:comment "The computer programming language." .
schema:codeRepository a rdfs:Property ; rdfs:label "code repository" ; rdfs:comment "Link to the repository where the un-compiled, human readable code and related code is located (SVN, GitHub, CodePlex)."   .
schema:dateCreated a rdfs:Property ; rdfs:label "date created" ;  rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed." .
schema:datePublished a rdfs:Property ; rdfs:label "date published" ; rdfs:comment "Date of first publication or broadcast" .
org:hasUnit a rdfs:Property ; rdfs:label "has unit"; rdfs:comment "Indicates a unit which is part of this Organization, e.g. a Department within a larger Organization.".
org:unitOf a rdfs:Property ; rdfs:label "unit of"; rdfs:comment "Indicates an Organization of which this Unit is a part, e.g. a Department within a larger Organization.".
org:hasMembership a rdfs:Property ; rdfs:label "has membership"; rdfs:comment "Indicates a membership relationship that the Agent plays." .
org:organization a rdfs:Property ; rdfs:label "organization" .
org:role a rdfs:Property ; rdfs:label "role" .
time:hasBeginning a rdfs:Property ; rdfs:label "has beginning" ; rdfs:comment "The beginning of the temporal entity." .
time:hasEnd a rdfs:Property ; rdfs:label "has end" ; rdfs:comment "The end of the temporal entity." .
ex:gitUsername a rdfs:Property ; rdfs:label "git username" ; rdfs:comment "The GitHub/Git handle of a person." .
ex:infoscienceUsername a rdfs:Property ; rdfs:label "infoscience username" ; rdfs:comment "The Infoscience username of a person." .
ex:hasCommit a rdfs:Property ; rdfs:label "has commit" ; rdfs:comment "Links a person to a specific commit they have made in a software repository." .
ex:discipline a rdf:Property ; rdfs:label "Discipline" ; rdfs:comment "The academic or scientific discipline associated with the resource." .
ex:repositoryType a rdf:Property ; rdfs:label "Repository Type" ; rdfs:comment "The type or category of the repository (e.g., software, data, publication)." .
ex:OrganizationType a rdf:Property ; rdfs:label "Organization Type" ; rdfs:comment "The type or category of the organization (e.g., university, research institute, company)." .

# Custom Organization <-> Repository Links
ex:managedRepository a rdfs:Property ; rdfs:label "managed repository" ; rdfs:comment "Links an organization to a software repository it officially manages or owns." ; owl:inverseOf ex:managedBy .
ex:managedBy a rdfs:Property ; rdfs:label "managed by" ; rdfs:comment "Links a software repository to its managing or owning organization." .
ex:relatedDataset a rdfs:Property ; rdfs:label "related dataset" ; rdfs:comment "A dataset that is utilized, processed, or produced by this software source code." ; rdfs:subPropertyOf schema:relatedLink ; owl:inverseOf ex:relatedSoftware .
ex:relatedSoftware a rdfs:Property ; rdfs:label "related software" ; rdfs:comment "The software project or source code that utilizes or produces this dataset." ; rdfs:subPropertyOf schema:relatedLink .
ex:githubOrgUrl a rdfs:Property ; rdfs:label "GitHub Organization URL" ; rdfs:comment "The official GitHub Organization URL for an EPFL unit." ; rdfs:subPropertyOf schema:url .
# ---------------------------------------------------------
# 2. REUSABLE PROPERTY SHAPES
# ---------------------------------------------------------

ex:nameShape
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 .

ex:EmailShape
    a sh:PropertyShape ;
    sh:path schema:email ;
    sh:nodeKind sh:Literal ;
    sh:pattern "^[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$" ;
    sh:description "Reusable validation for institutional and personal email addresses." .

ex:GenderShape
    a sh:PropertyShape ;
    sh:path schema:gender ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "Male" "Female" "N/A" ) .

ex:urlShape
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:nodeKind sh:IRI ;
    sh:description "Standard validation for any web URL." .

ex:OrganizationTypeShape
    a sh:PropertyShape ;
    sh:path ex:OrganizationType ;
    sh:class ex:OrganizationTypeEnumeration ;
    sh:name "Organization Type" ;
    sh:description "Must be a valid IRI from the Organization Type enumeration (e.g., ex:University)." .

ex:GitUsernameShape
    a sh:PropertyShape ;
    sh:path ex:gitUsername ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:description "The GitHub/Git handle of a person." .

ex:GitHashShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^([0-9a-f]{7}|[0-9a-f]{40})$" ;
    sh:name "Git Commit Hash" ;
    sh:description "A Git commit identifier in either short (7-character) or long (40-character) hex format." .

ex:DisciplineShape
    a sh:PropertyShape ;
    sh:path ex:discipline ;
    sh:class ex:DisciplineEnumeration ;
    sh:name "Discipline" ;
    sh:description "Must be a valid IRI from the Wikidata-based Discipline enumeration." .

ex:RepositoryTypeShape
    a sh:PropertyShape ;
    sh:path ex:repositoryType ;
    sh:class ex:RepositoryTypeEnumeration ;
    sh:name "Repository Type" ;
    sh:description "Must be a valid IRI from the Repository Type enumeration (e.g., ex:Software)." .


ex:DoiPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$" ;
    sh:description "Standard DOI validation." .

ex:RorPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^https://ror\\.org/[0-9a-z]{9}$" ;
    sh:description "Standard ROR ID validation." .

ex:HasUnitPropertyShape
    a sh:PropertyShape ;
    sh:path org:hasUnit ;
    sh:class org:Organization ; 
    sh:description "Link to a subunit, project, or department." .

ex:UnitOfPropertyShape
    a sh:PropertyShape ;
    sh:path org:unitOf ;
    sh:class org:Organization ; 
    sh:description "Link back to the managing/parent organization." .

# ---------------------------------------------------------
# 3. NODE SHAPES
# ---------------------------------------------------------

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:GitUsernameShape ;
    sh:property ex:EmailShape ;
    sh:property ex:GenderShape ;
    sh:property ex:urlShape ;
    sh:property [ sh:path ex:infoscienceUsername ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Infoscience Username" ] ;
    sh:property [ 
        sh:path org:hasMembership ; 
        sh:class org:Membership ;
        sh:name "hasMembership"
    ] ;
    sh:property [ 
        sh:path [ sh:inversePath schema:creator ] ; 
        sh:class schema:SoftwareSourceCode ; 
        sh:name "Created Repositories" ;
        sh:comment "Repositories created by this person." ;
        sh:description "The creator/author of this CreativeWork."
    ] .

ex:ArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:DoiPropertyShape ;
    sh:property [ sh:path schema:headline ; sh:datatype xsd:string ; sh:name "Headline" ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ; sh:name "Publication Date" ] ;
    sh:property [ sh:path schema:author ; sh:class schema:Person ; sh:minCount 1 ; sh:name "Author"; sh:description "The author of this content or rating."   ] ;
    sh:property [ sh:path schema:sourceOrganization ; sh:class org:Organization ; sh:name "Source Organization" ] .

ex:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass org:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:RorPropertyShape ;
    sh:property ex:urlShape ;
    sh:property ex:OrganizationTypeShape ;
    sh:property [ 
        sh:path ex:githubOrgUrl ; 
        sh:nodeKind sh:IRI ; 
        sh:pattern "^https://github\\.com/[a-zA-Z0-9\\-_]+$" ;
        sh:name "GitHub Organization URL" ;
        sh:description "A valid GitHub Organization link (e.g., https://github.com/swissdatasciencecenter)."
    ] ;
    sh:property [ 
        sh:path ex:managedRepository ; 
        sh:class schema:SoftwareSourceCode ; 
        sh:name "Managed Repositories" ;
        sh:description "Direct link to repositories managed by this organization."
    ] ;
    sh:property ex:HasUnitPropertyShape ;
    sh:property ex:UnitOfPropertyShape .

ex:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass schema:SoftwareSourceCode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:name "Creation Date" ] ;
    sh:property [ sh:path schema:codeRepository ; sh:nodeKind sh:IRI ;sh:pattern "^https?://(github|gitlab|bitbucket)\\.com/" ;  sh:flags "i" ; sh:name "Code Repository URL" ] ; 
    sh:property [sh:path schema:license ; sh:nodeKind sh:IRI ; sh:name "License" ] ;
    sh:property [sh:path schema:citation ; sh:nodeKind sh:IRI ; sh:name "Citation" ] ;
    sh:property [ sh:path ex:relatedDataset ; sh:class schema:Dataset ; sh:name "Related Dataset" ; sh:description "The dataset(s) associated with this software repository."] ;
    sh:property [ sh:path schema:programmingLanguage ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ex:hasCommit ; sh:class ex:GitCommit ] ;
    sh:property [ sh:path schema:creator ; sh:class schema:Person ;sh:minCount 1 ;sh:name "Creator" ] ;
    sh:property [ sh:path ex:managedBy ; sh:class org:Organization ; sh:maxCount 1 ;
        sh:name "Managing Organization" ;
        sh:description "The organization that officially manages this repository."
    ] ;
    sh:property ex:RepositoryTypeShape ;
    sh:property ex:DisciplineShape    .

ex:DatasetShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;        
    sh:property ex:urlShape ;         
    sh:property ex:DoiPropertyShape ; 
    sh:property [ sh:path schema:description ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ] ;
    sh:property [ 
        sh:path ex:relatedSoftware ; 
        sh:class schema:SoftwareSourceCode ;
        sh:name "Related Software" ;
        sh:description "The software project(s) associated with this dataset."
    ] .

ex:CommitShape
    a sh:NodeShape ;
    sh:targetClass ex:GitCommit ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:GitHashShape ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:author ; sh:class schema:Person ; sh:name "Author" ] .

ex:MembershipShape
    a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ 
        sh:path org:organization ; 
        sh:class org:Organization ;
        sh:minCount 1 ;                
        sh:maxCount 1 ;                
        sh:nodeKind sh:IRI ;
        sh:name "Organization"
    ] ;
    sh:property [ sh:path org:role ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Role"; ] ;
    sh:property [ 
        sh:path time:hasBeginning ; 
        sh:datatype xsd:date ; 
        sh:minCount 1 ; 
        sh:lessThan time:hasEnd ;
        sh:name "Start Date"
    ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:name "End Date" ] .