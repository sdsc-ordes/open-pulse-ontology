@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix ex:     <http://example.org/> .
@prefix pulse:  <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .

# ---------------------------------------------------------
# 1. CLASS & PROPERTY SECTION
# ---------------------------------------------------------
<https://open-pulse.epfl.ch/ontology#> a owl:Ontology ;
    dct:abstract "The Open Pulse Ontology to model contributions to open source scientific software and research articles from EPFL." ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    dct:title "Open Pulse Ontology" ;
    owl:versionInfo "v.2.0"^^xsd:string .

# Classes
schema:Person a rdfs:Class ; rdfs:label "Person" ; rdfs:comment "An individual researcher or contributor." .
schema:ScholarlyArticle a rdfs:Class ; rdfs:label "Scholarly Article" ; rdfs:comment "A research paper or publication." .
schema:SoftwareSourceCode a rdfs:Class ; rdfs:label "Software Repository" ; rdfs:comment "A software project or source code." .
schema:Dataset a rdfs:Class ; rdfs:label "Dataset" ; rdfs:comment "Data collections used or generated by research software." .
org:Membership a rdfs:Class ; rdfs:label "Membership" ; rdfs:comment "A affiliation between a Person and an Organization." .
org:Organization a rdfs:Class ; rdfs:label "Organization" ; rdfs:comment "A research center, university, or lab." .
ex:GitCommit a rdfs:Class ; rdfs:label "Git Commit" ; rdfs:comment "A specific record of changes in a software repository." .

# Properties
schema:name a rdfs:Property ; rdfs:label "name" ; rdfs:comment "The primary name or title of the entity." .
schema:email a rdfs:Property ; rdfs:label "email" ; rdfs:comment "The electronic mail address of a person." .
schema:url a rdfs:Property ; rdfs:label "url" ; rdfs:comment "The web address (URL) of the resource." .
schema:identifier a rdfs:Property ; rdfs:label "identifier" ; rdfs:comment "A unique identifier such as a DOI or ROR ID." .
schema:creator a rdfs:Property ; rdfs:label "creator" ; rdfs:comment "The author/creator of this CreativeWork." .
schema:accountablePerson a rdfs:Property ; rdfs:label "accountable person" ; rdfs:comment "The person responsible for maintaining the resource." .
schema:hasPart a rdfs:Property ; rdfs:label "has part" ; rdfs:comment "Links an organization to a repository it officially contains." .
ex:relatedDataset a rdfs:Property ; rdfs:label "related dataset" ; rdfs:comment "A dataset that is utilized, processed, or produced by this software source code." ; rdfs:subPropertyOf schema:relatedLink .
schema:programmingLanguage a rdfs:Property ; rdfs:label "programming language" .
schema:codeRepository a rdfs:Property ; rdfs:label "code repository" .
schema:dateCreated a rdfs:Property ; rdfs:label "date created" .
schema:datePublished a rdfs:Property ; rdfs:label "date published" .
org:hasUnit a rdfs:Property ; rdfs:label "has unit" .
org:unitOf a rdfs:Property ; rdfs:label "unit of" .
org:hasMembership a rdfs:Property ; rdfs:label "has membership" .
org:organization a rdfs:Property ; rdfs:label "organization" .
org:role a rdfs:Property ; rdfs:label "role" .
time:hasBeginning a rdfs:Property ; rdfs:label "has beginning" .
time:hasEnd a rdfs:Property ; rdfs:label "has end" .
ex:gitUsername a rdfs:Property ; rdfs:label "git username" .
ex:infoscienceUsername a rdfs:Property ; rdfs:label "infoscience username" .
ex:hasCommit a rdfs:Property ; rdfs:label "has commit" .
ex:metadata a rdfs:Property ; rdfs:label "metadata" .

# ---------------------------------------------------------
# 2. REUSABLE PROPERTY SHAPES
# ---------------------------------------------------------

ex:nameShape
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 .

ex:EmailShape
    a sh:PropertyShape ;
    sh:path schema:email ;
    sh:nodeKind sh:Literal ;
    sh:pattern "^[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$" ;
    sh:description "Reusable validation for institutional and personal email addresses." .

ex:GenderShape
    a sh:PropertyShape ;
    sh:path schema:gender ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "Male" "Female" "N/A" ) .

ex:urlShape
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:nodeKind sh:IRI ;
    sh:description "Standard validation for any web URL." .

ex:GitUsernameShape
    a sh:PropertyShape ;
    sh:path ex:gitUsername ;
    sh:datatype xsd:string ;
    sh:description "The GitHub/Git handle of a person." .

ex:gitMetadataShape
    a sh:PropertyShape ;
    sh:path ex:metadata ;
    sh:datatype xsd:string ;
    sh:minCount 1 .

ex:GitHashShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^([0-9a-f]{7}|[0-9a-f]{40})$" ;
    sh:name "Git Commit Hash" ;
    sh:description "A Git commit identifier in either short (7-character) or long (40-character) hex format." .

ex:DoiPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$" ;
    sh:description "Standard DOI validation." .

ex:RorPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^https://ror\\.org/[0-9a-z]{9}$" ;
    sh:description "Standard ROR ID validation." .

ex:HasUnitPropertyShape
    a sh:PropertyShape ;
    sh:path org:hasUnit ;
    sh:class org:Organization ; 
    sh:description "Link to a subunit, project, or department." .

ex:UnitOfPropertyShape
    a sh:PropertyShape ;
    sh:path org:unitOf ;
    sh:class org:Organization ; 
    sh:description "Link back to the managing/parent organization." .

# ---------------------------------------------------------
# 3. NODE SHAPES
# ---------------------------------------------------------

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:GitUsernameShape ;
    sh:property ex:EmailShape ;
    sh:property ex:GenderShape ;
    sh:property ex:urlShape ;
    sh:property [ sh:path ex:infoscienceUsername ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Infoscience Username"
    ] ;
    sh:property [ 
        sh:path org:hasMembership ; 
        sh:node ex:MembershipShape ;
        sh:name "hasMembership"
    ] ;
    sh:property [ 
        sh:path [ sh:inversePath schema:creator ] ; 
        sh:node ex:RepositoryShape ;
        sh:name "Created Repositories" ;
        sh:description "Software repositories where this person is the primary creator/author."
    ] .

ex:ArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:DoiPropertyShape ;
    sh:property [ sh:path schema:headline ; sh:datatype xsd:string ; sh:name "Headline" ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ; sh:name "Publication Date" ] ;
    sh:property [ sh:path schema:author ; sh:node ex:PersonShape ; sh:minCount 1 ; sh:name "Author" ] ;
    sh:property [ sh:path schema:sourceOrganization ; sh:node ex:OrganizationShape ; sh:minCount 1 ; sh:name "Source Organization" ] .

ex:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass org:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:RorPropertyShape ;
    sh:property ex:urlShape ;
    sh:property [ 
        sh:path schema:publishingPrinciples ; 
        sh:nodeKind sh:IRI ; 
        sh:name "GitHub Org Link" ;
        sh:description "Link to the GitHub Organization URL." 
    ] ;
    sh:property [ 
        sh:path schema:hasPart ; 
        sh:node ex:RepositoryShape ; 
        sh:name "Institutional Repositories" ;
        sh:description "Software projects that are part of this organization's official output."
    ] ;
    sh:property ex:HasUnitPropertyShape ;
    sh:property ex:UnitOfPropertyShape .

ex:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass schema:SoftwareSourceCode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ; 
    sh:property ex:gitMetadataShape ;
    sh:property [ 
        sh:path ex:relatedDataset ; 
        sh:node ex:DatasetShape ;
        sh:name "Related Dataset" ;
        sh:description "Link to a dataset associated with this software."
    ] ;
    sh:property [ sh:path schema:programmingLanguage ; sh:datatype xsd:string ; sh:name "Language" ] ;
    sh:property [ sh:path schema:codeRepository ; sh:nodeKind sh:IRI ; sh:name "GitHub URL" ] ; 
    sh:property [ sh:path schema:citation ; sh:nodeKind sh:IRI ; sh:name "Software Citation" ] ;
    sh:property [ sh:path schema:applicationCategory ; sh:datatype xsd:string ; sh:name "Category" ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:name "Date Created" ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:dateTime ; sh:name "Date Published" ] ;
    sh:property [ sh:path ex:hasCommit ; sh:node ex:CommitShape ; sh:name "Commits" ] ;
    sh:property [ 
        sh:path schema:creator ; 
        sh:node ex:PersonShape ;
        sh:minCount 1 ;
        sh:name "Creator" ;
        sh:description "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork."
    ] ;
    sh:property [ 
        sh:path schema:accountablePerson ; 
        sh:node ex:PersonShape ;
        sh:maxCount 1 ;
        sh:name "Accountable Person" ;
        sh:description "The primary contact or lead maintainer responsible for this software."
    ] ;

    # 3. INSTITUTIONAL OWNERSHIP
    sh:property [ 
        sh:path [ sh:inversePath schema:hasPart ] ; 
        sh:node ex:OrganizationShape ;
        sh:maxCount 1 ;
        sh:name "Owning Organization" ;
        sh:description "The institutional parent (e.g., SDSC) of this repository."
    ] .

ex:DatasetShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;        
    sh:property ex:urlShape ;         
    sh:property ex:DoiPropertyShape ; 
    sh:property [ sh:path schema:description ; sh:datatype xsd:string ; sh:minCount 1 ; sh:name "Description" ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ; sh:name "Date Published" ] ;
    sh:property [ 
        sh:path [ sh:inversePath ex:relatedDataset ] ; 
        sh:node ex:RepositoryShape ;
        sh:name "Related Software" ;
        sh:description "Software repositories that use or are related to this dataset."
    ] .

ex:CommitShape
    a sh:NodeShape ;
    sh:targetClass ex:GitCommit ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:GitHashShape ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:name "Commit Date" ] ;
    sh:property [ sh:path schema:author ; sh:node ex:PersonShape ; sh:name "Author" ] .

ex:MembershipShape
    a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ 
        sh:path org:organization ; 
        sh:node ex:OrganizationShape ;
        sh:minCount 1 ;                
        sh:maxCount 1 ;                
        sh:nodeKind sh:IRI ;
        sh:name "Organization"
    ] ;
    sh:property [ sh:path org:role ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Role" ] ;
    sh:property [ 
        sh:path time:hasBeginning ; 
        sh:datatype xsd:date ; 
        sh:minCount 1 ; 
        sh:lessThan time:hasEnd ;
        sh:name "Start Date"
    ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:name "End Date" ] .