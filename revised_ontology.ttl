@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix ex:     <http://example.org/> .
@prefix pulse:  <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .

# ---------------------------------------------------------
# 1. CLASS & PROPERTY SECTION
# ---------------------------------------------------------
<https://open-pulse.epfl.ch/ontology#> a owl:Ontology ;
    dct:abstract "The Open Pulse Ontology to model contributions to open source scientific software and research articles from EPFL." ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    dct:title "Open Pulse Ontology" ;
    owl:versionInfo "v.2.0"^^xsd:string .

schema:Person a rdfs:Class ; rdfs:label "Person" ; rdfs:comment "Represents an individual researcher or contributor." .

schema:ScholarlyArticle a rdfs:Class ; rdfs:label "Scholarly Article" ; rdfs:comment "A research publication or paper." .

schema:SoftwareSourceCode a rdfs:Class ; rdfs:label "Software Repository" ; rdfs:comment "A software project or source code repository." .

schema:Dataset a rdfs:Class ; rdfs:label "Dataset" ; rdfs:comment "Data collections used or generated by research software." .

org:Membership a rdfs:Class ; rdfs:label "Membership" ; rdfs:comment "A time-bound affiliation between a Person and an Organization." .

org:Organization a rdfs:Class ; rdfs:label "Organization" ; rdfs:comment "A research center, university, or lab." .

ex:GitCommit a rdfs:Class ; rdfs:label "Git Commit" ; rdfs:comment "A specific record of changes in a software repository." .

# Linking Relationship Descriptions
schema:creator rdfs:label "creator" ; rdfs:comment "Links a person to a repository they personally created or own." .
schema:hasPart rdfs:label "has part" ; rdfs:comment "Links an organization to a repository that belongs to it officially." .
schema:dataset rdfs:label "dataset" ; rdfs:comment "Links software to its associated data collections." .
org:organization rdfs:label "organization" ; rdfs:comment "The specific organization a membership belongs to." .
schema:accountablePerson rdfs:label "accountable person" ; rdfs:comment "The person responsible for the maintenance of a software project." .

# ---------------------------------------------------------
# 2. REUSABLE PROPERTY SHAPES
# ---------------------------------------------------------

ex:nameShape
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 .

ex:urlShape
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:nodeKind sh:IRI ;
    sh:description "Standard validation for any web URL." .

ex:GitUsernameShape
    a sh:PropertyShape ;
    sh:path ex:gitUsername ;
    sh:datatype xsd:string ;
    sh:description "The GitHub/Git handle of a person." .

ex:gitMetadataShape
    a sh:PropertyShape ;
    sh:path ex:metadata ;
    sh:datatype xsd:string ;
    sh:minCount 1 .

ex:DoiPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$" ;
    sh:description "Standard DOI validation." .

ex:RorPropertyShape
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:datatype xsd:string ;
    sh:pattern "^https://ror\\.org/[0-9a-z]{9}$" ;
    sh:description "Standard ROR ID validation." .

ex:HasUnitPropertyShape
    a sh:PropertyShape ;
    sh:path org:hasUnit ;
    sh:class org:Organization ; 
    sh:description "Link to a subunit, project, or department." .

ex:UnitOfPropertyShape
    a sh:PropertyShape ;
    sh:path org:unitOf ;
    sh:class org:Organization ; 
    sh:description "Link back to the managing/parent organization." .

# ---------------------------------------------------------
# 3. NODE SHAPES
# ---------------------------------------------------------

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:GitUsernameShape ;
    sh:property [ sh:path schema:email ; sh:nodeKind sh:Literal ; sh:pattern "^[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$" ] ;
    sh:property [ sh:path schema:gender ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:in ( "Male" "Female" "N/A" ) ] ;
    sh:property ex:urlShape ;
    sh:property [ sh:path ex:infoscienceUsername ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path org:hasMembership ; sh:node ex:MembershipShape ] ;
    sh:property [ 
        sh:path schema:creator ; 
        sh:node ex:RepositoryShape ;
        sh:description "Link to personal repositories owned by this user account." ;
    ] .

ex:ArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:DoiPropertyShape ;
    sh:property [ sh:path schema:headline ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:author ; sh:node ex:PersonShape ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:sourceOrganization ; sh:node ex:OrganizationShape ; sh:minCount 1 ] .

ex:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass org:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;
    sh:property ex:RorPropertyShape ;
    sh:property ex:urlShape ;
    sh:property [ 
        sh:path schema:publishingPrinciples ; 
        sh:nodeKind sh:IRI ; 
        sh:description "Link to the GitHub Organization URL." 
    ] ;
    sh:property [ 
        sh:path schema:hasPart ; 
        sh:node ex:RepositoryShape ; 
    ] ;
    sh:property ex:HasUnitPropertyShape ;
    sh:property ex:UnitOfPropertyShape .

ex:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass schema:SoftwareSourceCode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ; 
    sh:property ex:gitMetadataShape ;
    sh:property [ 
        sh:path schema:dataset ; 
        sh:node ex:DatasetShape ;
        sh:description "Link to a dataset associated with this software."
    ] ;
    sh:property [ sh:path schema:programmingLanguage ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:codeRepository ; sh:nodeKind sh:IRI ] ; 
    sh:property [ sh:path schema:citation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:applicationCategory ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ex:hasCommit ; sh:node ex:CommitShape ] ;
    sh:property [ 
        sh:path schema:accountablePerson ; 
        sh:node ex:PersonShape ;
        sh:description "Links the repo back to the personal owner."
    ] .

ex:DatasetShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property ex:nameShape ;        
    sh:property ex:urlShape ;         
    sh:property ex:DoiPropertyShape ; 
    sh:property [ sh:path schema:description ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ] .

ex:CommitShape
    a sh:NodeShape ;
    sh:targetClass ex:GitCommit ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:path schema:identifier ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ] ;
    sh:property [ 
        sh:path schema:author ; 
        sh:node ex:PersonShape ;
    ] .

ex:MembershipShape
    a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ 
        sh:path org:organization ; 
        sh:node ex:OrganizationShape ;
        sh:minCount 1 ;                
        sh:maxCount 1 ;                
        sh:nodeKind sh:IRI ;
        sh:description "The organization where the person holds this membership." ;
    ] ;
    sh:property [ sh:path org:role ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path time:hasBeginning ; sh:datatype xsd:date ; sh:minCount 1 ; sh:lessThan time:hasEnd ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:maxCount 1 ] .