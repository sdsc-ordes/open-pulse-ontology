@prefix schema: <http://schema.org/>.
@prefix sd: <https://w3id.org/okn/o/sd#>.
@prefix bio: <https://bioschemas.org/>.
@prefix spe: <https://openschemas.github.io/spec-container/specifications/>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix shsh: <http://www.w3.org/ns/shacl-shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix md4i: <http://w3id.org/nfdi4ing/metadata4ing#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> .
@prefix dmib: <https://biomedit.ch/rdf/sphn-schema/dmib#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://open-pulse.epfl.ch/ontology#>
    a owl:Ontology ;
    dct:abstract "The Open Pulse ontology provides concepts (classes and properties) to model human and machine readable imaging software metadata. It is the result of re-using external pre-existing vocabularies such as schema.org and the software description ontology, together with custom imaging specific objects and properties." ;
    dct:contributor "Robin Franken", "Carlos Vivar Rios" ;
    dct:created "2025-05-13"^^xsd:date ;
    dct:creator "Robin Franken" ;
    dct:description "The Open Pulse ontology provides concepts (classes and properties) to model human and machine readable imaging software metadata. It is the result of re-using external pre-existing vocabularies such as schema.org and the software description ontology, together with custom imaging specific objects and properties. The ontology contains purely semantic information (labels, definitions etc.) and is meant to be used in conjuction with a graph of enumeration values and a graph containing SHACL shapes to provide more machine readable restrictions on values of properties." ;
    dct:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    dct:modified "2025-05-13"^^xsd:date ;
    dct:title "Open pulse Ontology" ;
    vann:preferredNamespacePrefix "pulse" ;
    vann:preferredNamespaceUri "https://open-pulse.epfl.ch/ontology#"^^xsd:string ;
    owl:versionInfo "0.0.1"^^xsd:string 
    .

schema:SoftwareSourceCode
  a rdfs:Class ;
  rdfs:comment "A software application." ;
  rdfs:label "Software application" ;
  rdfs:subClassOf schema:CreativeWork .

schema:Person
  a rdfs:Class ;
  rdfs:comment "A person (alive, dead, undead, or fictional)." ;
  rdfs:label "Person" ;
.

schema:Organization
  a rdfs:Class ;
  rdfs:comment "An organization such as a school, NGO, corporation, club, etc." ;
  rdfs:label "Organization" ;
.

pulse:GitHubOrganization
  a rdfs:Class ;
  rdfs:comment "A GitHub organization." ;
  rdfs:label "GitHub organization" ;
.

schema:ScholarlyArticle
  a rdfs:Class ;
  rdfs:comment "A scholarly article, typically published in an academic journal or conference." ;
  rdfs:label "Scholarly Article" ;
  rdfs:subClassOf schema:CreativeWork ;
.

schema:Dataset
  a rdfs:Class ;
  rdfs:comment "A body of structured information describing some topic(s) of interest." ;
  rdfs:label "Dataset" ;
.

schema:Enumeration
  a rdfs:Class ;
  rdfs:comment "Lists or enumerations for schema:Thing property values." ;
  rdfs:label "Enumeration" ;
.

pulse:DisciplineEnumeration
  a rdfs:Class ;
  rdfs:comment "Enumeration of academic and scientific disciplines for categorizing software repositories." ;
  rdfs:label "Discipline Enumeration" ;
  rdfs:subClassOf schema:Enumeration ;
.

pulse:RepositoryTypeEnumeration
  a rdfs:Class ;
  rdfs:comment "Enumeration of types of repositories (software, educational resource, documentation, data, other)." ;
  rdfs:label "Repository Type Enumeration" ;
  rdfs:subClassOf schema:Enumeration ;
.
#####################################
schema:citation a rdf:Property;
  rdfs:comment "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc.";
  rdfs:label "Citation" .

schema:license a rdf:Property;
  rdfs:comment "A license document that applies to this content, typically indicated by URL.";
  rdfs:label "License" .

schema:contentUrl a rdf:Property;
  rdfs:comment "Actual bytes of the media object, for example the image file or video file.";
  rdfs:label "Content URL".

schema:dateCreated a rdf:Property;
  rdfs:comment "The date on which the repository was created.";
  rdfs:label "Date created" .

schema:datePublished a rdf:Property;
  rdfs:comment "Latest published git release date, else, the publish date of the doi.";
  rdfs:label "Date published" .

schema:author a rdf:Property;
  rdfs:comment "The author of the software, this can be organizations or people that are maintainers and/or producers of the software.";
  rdfs:label "Author" .

schema:affiliation a rdf:Property;
  rdfs:comment "An organization that this person is affiliated with. For example, a university (EPFL/ETHZ), lab, company." ;
  rdfs:label "Affiliation". 

schema:codeRepository a rdf:Property;
  rdfs:comment "Primary link to the repository where the un-compiled, human readable code and related code is located (GitLab, GitHub, CodePlex etc.).";
  rdfs:label "Code repository" .

schema:description a rdf:Property;
  rdfs:comment "A description of the item.";
  rdfs:label "Description" .

pulse:relatedToOrganization a rdf:Property ;
  rdfs:comment "The lab/institution/group/project/organization to which a software is related and/or affiliated to" ;
  rdfs:label "Related to organization" .

schema:familyName a rdf:Property;
  rdfs:comment "Family name. In the U.S., the last name of a Person.";
  rdfs:label "Family name" .

schema:givenName a rdf:Property;
  rdfs:comment "Given name. In the U.S., the first name of a Person.";
  rdfs:label "Given name" .

schema:name a rdf:Property;
  rdfs:comment "The name of a person, in the US their first and last name(s) seperated by spaces";
  rdfs:label "Name" .

md4i:orcidId a rdf:Property ;
  rdfs:comment "The ORCID ID of a person" ;
  rdfs:label "Has ORCID ID" .

md4i:hasRorId a rdf:Property ;
  rdfs:comment "A Research Organization Registry identifier, that points to a research organization" ;
  rdfs:label "Has ROR ID" .

schema:legalName a rdf:Property;
  rdfs:comment "The official name of the organization, e.g. the registered company name.";
  rdfs:label "Legal name" .

schema:programmingLanguage a rdf:Property;
  rdfs:comment "The computer programming language.";
  rdfs:label "Programming Language" .

schema:url a rdf:Property;
  rdfs:comment "Fill in any URL related to this repository. e.g. related lab or project website.";
  rdfs:label "URL" .

schema:identifier a rdf:Property;
  rdfs:comment "Represents any kind of unique string to identify something, such as ISBNs, GTIN codes, UUIDs etc.";
  rdfs:label "Identifier" .

sd:readme a rdf:Property;
  rdfs:comment "URL to the Readme file of a software component"@en;
  rdfs:label "Readme"@en .

sd:hasAcknowledgements a rdf:Property;
  rdfs:comment "String with the people, organizations and other contributors acknowledged by the authors."@en;
  rdfs:label "Has acknowledgements"@en .

pulse:discipline a rdf:Property ;
    rdfs:comment "The academic or scientific discipline associated with the software or research." ;
    rdfs:label "Discipline" .

pulse:repositoryType a rdf:Property ;
    rdfs:comment "The type of repository, such as software, educational resource, documentation, data or other ." ;
    rdfs:label "Repository Type" ;
    rdfs:range xsd:string ;
    rdfs:domain schema:SoftwareSourceCode .

schema:username a rdf:Property ;
    rdfs:comment "The username of a person or organization on GitHub or other similar platforms." ;
    rdfs:label "Username" ;
    rdfs:range xsd:string .

schema:jobTitle a rdf:Property ;
    rdfs:comment "The job title of a person (e.g., Financial Manager)." ;
    rdfs:label "Job Title" ;
    rdfs:range xsd:string ;
    rdfs:domain schema:Person .

schema:featureList a rdf:Property ;
    rdfs:comment "Features or modules provided by this software or application." ;
    rdfs:label "Feature List" ;
    rdfs:range xsd:string ;
    rdfs:domain schema:SoftwareSourceCode .

schema:applicationCategory a rdf:Property ;
    rdfs:comment "Type of software application, e.g., 'Game, Multimedia'." ;
    rdfs:label "Application Category" ;
    rdfs:range xsd:string ;
    rdfs:domain schema:SoftwareSourceCode .

pulse:hasRepository a rdf:Property ;
  rdfs:comment "A software repository that is part of a GitHub organization." ;
  rdfs:label "Has repository" ; 
  rdfs:domain pulse:GitHubOrganization ;
  rdfs:range schema:SoftwareSourceCode .

schema:memberOf a rdf:Property ;
  rdfs:comment "A person or organization that is a member of a GitHub organization." ;
  rdfs:label "Member of" ;
  rdfs:domain pulse:GitHubOrganization ;
  rdfs:range schema:Person .

pulse:AcademicCatalogRelation a rdfs:Class ;
  rdfs:comment "A relation between a software repository or person and an entity in an academic catalog system (e.g., Infoscience)." ;
  rdfs:label "Academic Catalog Relation" .

pulse:CatalogEntity a rdfs:Class ;
  rdfs:comment "An entity from an academic catalog system with detailed metadata." ;
  rdfs:label "Catalog Entity" .

# Properties for Academic Catalog Relations

pulse:hasAcademicCatalogRelation a rdf:Property ;
  rdfs:comment "Links a resource to a relation with an academic catalog entity." ;
  rdfs:label "Has academic catalog relation" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range pulse:AcademicCatalogRelation .

pulse:catalogType a rdf:Property ;
  rdfs:comment "The type of academic catalog system (e.g., 'infoscience')." ;
  rdfs:label "Catalog type" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range xsd:string .

pulse:entityType a rdf:Property ;
  rdfs:comment "The type of entity in the catalog (e.g., 'person', 'publication', 'organization')." ;
  rdfs:label "Entity type" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range xsd:string .

pulse:hasCatalogEntity a rdf:Property ;
  rdfs:comment "The detailed entity information from the academic catalog." ;
  rdfs:label "Has Catalog entity" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range pulse:CatalogEntity .

pulse:confidence a rdf:Property ;
  rdfs:comment "A confidence score (0-1) indicating the reliability of the catalog relation match." ;
  rdfs:label "Confidence" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range xsd:decimal .

# Properties for Catalog Entity

pulse:uuid a rdf:Property ;
  rdfs:comment "A universally unique identifier for the catalog entity." ;
  rdfs:label "UUID" ;
  rdfs:domain pulse:CatalogEntity ;
  rdfs:range xsd:string .

schema:email a rdf:Property ;
  rdfs:comment "The email address of a person or organization." ;
  rdfs:label "Email" ;
  rdfs:range xsd:string .

pulse:profileUrl a rdf:Property ;
  rdfs:comment "The URL to the entity's profile page in the academic catalog." ;
  rdfs:label "Profile URL" ;
  rdfs:domain pulse:CatalogEntity ;
  rdfs:range xsd:anyURI .

pulse:publicationCount a rdf:Property ;
  rdfs:comment "The number of publications associated with the entity in the catalog." ;
  rdfs:label "Publication count" ;
  rdfs:domain pulse:CatalogEntity ;
  rdfs:range xsd:integer .

pulse:researchInterests a rdf:Property ;
  rdfs:comment "Research interests or topics associated with the entity." ;
  rdfs:label "Research interests" ;
  rdfs:domain pulse:CatalogEntity ;
  rdfs:range xsd:string .

pulse:justification a rdf:Property ;
  rdfs:comment "An explanation of how a catalog relation or match was established." ;
  rdfs:label "Justification" ;
  rdfs:range xsd:string .

pulse:externalId a rdf:Property ;
  rdfs:comment "An external identifier used for matching in a catalog system." ;
  rdfs:label "External ID" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range xsd:string .

pulse:matchedOn a rdf:Property ;
  rdfs:comment "The fields or properties that were used to establish a match (e.g., 'name', 'email')." ;
  rdfs:label "Matched on" ;
  rdfs:domain pulse:AcademicCatalogRelation ;
  rdfs:range xsd:string .

pulse:relatedToEPFL a rdf:Property ;
  rdfs:comment "Indicates whether a software repository or entity is related to EPFL (École Polytechnique Fédérale de Lausanne)." ;
  rdfs:label "Related to EPFL" ;
  rdfs:range xsd:boolean .

pulse:source a rdf:Property ;
  rdfs:comment "The source or origin of the data or metadata." ;
  rdfs:label "Source" ;
  rdfs:range xsd:string .

pulse:linkedEntities a rdf:Property ;
  rdfs:comment "Entities that are linked or associated with this resource." ;
  rdfs:label "Linked entities" ;
  rdfs:range xsd:string .

pulse:relatedModels a rdf:Property ;
  rdfs:comment "Machine learning models or computational models related to the software." ;
  rdfs:label "Related models" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:string .

pulse:firstCommitDate a rdf:Property ;
  rdfs:comment "The date of the first commit in the repository." ;
  rdfs:label "First commit date" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:date .

pulse:lastCommitDate a rdf:Property ;
  rdfs:comment "The date of the most recent commit in the repository." ;
  rdfs:label "Last commit date" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:date .

pulse:gitAuthors a rdf:Property ;
  rdfs:comment "Authors who have contributed commits to the git repository." ;
  rdfs:label "Git authors" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range schema:Person .

pulse:relatedPublications a rdf:Property ;
  rdfs:comment "Academic publications related to or citing the software." ;
  rdfs:label "Related publications" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range schema:ScholarlyArticle .

pulse:relatedAPIs a rdf:Property ;
  rdfs:comment "APIs (Application Programming Interfaces) that are related to or used by the software." ;
  rdfs:label "Related APIs" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:string .

pulse:relatedDatasets a rdf:Property ;
  rdfs:comment "Datasets that are related to, used by, or produced by the software." ;
  rdfs:label "Related datasets" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range schema:Dataset .

pulse:totalCommits a rdf:Property ;
  rdfs:comment "The total number of commits in the repository." ;
  rdfs:label "Total commits" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:integer .

pulse:commits a rdf:Property ;
  rdfs:comment "The number of commits, or detailed commit information." ;
  rdfs:label "Commits" ;
  rdfs:domain schema:SoftwareSourceCode ;
  rdfs:range xsd:integer .

pulse:metadata a rdf:Property ;
  rdfs:comment "Additional metadata information about the resource." ;
  rdfs:label "Metadata" ;
  rdfs:range xsd:string .


