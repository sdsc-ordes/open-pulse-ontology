@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix pulse:     <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix coar-access: <http://purl.org/coar/access_right/> .
@prefix coar-resource: <http://purl.org/coar/resource_type/> .

# ---------------------------------------------------------
# ENUMERATIONS SECTION
# ---------------------------------------------------------

# Enumeration Classes
schema:Enumeration a rdfs:Class ; skos:prefLabel "Enumeration" ; skos:definition "A type that defines a set of discrete values." .
pulse:DisciplineEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Discipline Enumeration" ; skos:definition "Enumeration of academic and scientific disciplines." ; rdfs:comment "Discipline enumeration values are derived from EPFL Graph disciplines structure. (https://graphsearch.epfl.ch/en/category/academic-disciplines)".
pulse:RepositoryTypeEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Repository Type Enumeration" ; skos:definition "Enumeration of repository types used within the ontology." .
pulse:OrganizationTypeEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Organization Type Enumeration" ; skos:definition "Enumeration of organization types used within the ontology." .
pulse:PlatformEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Platform Enumeration" ; skos:definition "Enumeration of external platforms on which a person can hold a profile." .
pulse:PublicationTypeEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Publication Type Enumeration" ; skos:definition "Enumeration of scholarly publication types, aligned with DataCite's resourceTypeGeneral vocabulary." .
pulse:AccessRightEnumeration a rdfs:Class ; rdfs:subClassOf schema:Enumeration ; skos:prefLabel "Access Right Enumeration" ; skos:definition "Enumeration of open-access statuses for a publication, aligned with OpenAIRE's access rights vocabulary." .

# Enumeration Instances - Repository Types
pulse:Software a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Software"@en ; skos:definition "A repository that contains software source code."@en .
pulse:EducationalResource a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Educational Resource"@en ; skos:definition "A repository that contains educational materials."@en .
pulse:Documentation a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Documentation"@en ; skos:definition "A repository that contains documentation."@en .
pulse:Data a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Data"@en ; skos:definition "A repository that contains datasets."@en .
pulse:Model a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Model"@en ; skos:definition "A repository that contains a trained machine learning model."@en .
pulse:Space a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Space"@en ; skos:definition "A repository that hosts an interactive application or demo (e.g. a Hugging Face Space)."@en .
pulse:Other a pulse:RepositoryTypeEnumeration ; skos:prefLabel "Other"@en ; skos:definition "A repository that does not fit into the other categories."@en .

# Enumeration Instances - Organization Types
pulse:University a pulse:OrganizationTypeEnumeration ; skos:prefLabel "University"@en ; skos:definition "An educational institution."@en .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Research Institution"@en ; skos:definition "a research institution is one that has made conducting research a vital part of its mission and goals."@en .
pulse:GovernmentAgency a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Government Agency"@en ; skos:definition "A government organization."@en .
pulse:SoftwareProject a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Software Project"@en ; skos:definition "An organization focused on development of specific software."@en .
pulse:PrivateCompany a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Private Company"@en ; skos:definition "A privately owned business organization."@en .
pulse:NonProfitOrganization a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Non-Profit Organization"@en ; skos:definition "An organization that operates for a charitable or social purpose rather than for profit."@en .
pulse:CommunitySpace a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Community Space"@en ; skos:definition "A community-driven organization or space."@en .
pulse:Publisher a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Publisher"@en ; skos:definition "An organization that holds, archives, publishes, distributes, or issues research outputs (e.g. a journal publisher or university press)."@en .
pulse:OtherOrganizationType a pulse:OrganizationTypeEnumeration ; skos:prefLabel "Other"@en ; skos:definition "An organization type that does not fit into the other categories."@en .

# Enumeration Instances - Platforms
pulse:GitHub a pulse:PlatformEnumeration ; skos:prefLabel "GitHub"@en ; skos:definition "The GitHub code-hosting platform."@en .
pulse:GitLab a pulse:PlatformEnumeration ; skos:prefLabel "GitLab"@en ; skos:definition "The GitLab code-hosting platform."@en .
pulse:Bitbucket a pulse:PlatformEnumeration ; skos:prefLabel "Bitbucket"@en ; skos:definition "The Bitbucket code-hosting platform."@en .
pulse:Infoscience a pulse:PlatformEnumeration ; skos:prefLabel "Infoscience"@en ; skos:definition "EPFL's Infoscience institutional publication repository."@en .
pulse:ORCID a pulse:PlatformEnumeration ; skos:prefLabel "ORCID"@en ; skos:definition "The ORCID researcher-identifier registry."@en .
pulse:HuggingFace a pulse:PlatformEnumeration ; skos:prefLabel "Hugging Face"@en ; skos:definition "The Hugging Face platform for hosting models, datasets, and Spaces."@en .
pulse:Zenodo a pulse:PlatformEnumeration ; skos:prefLabel "Zenodo"@en ; skos:definition "The Zenodo research-data and software archive operated by CERN."@en .

# Enumeration Instances - Publication Types
# skos:exactMatch/closeMatch align these with the COAR Resource Types vocabulary
# (https://vocabularies.coar-repositories.org/resource_types/), which OpenAIRE mandates.
pulse:JournalArticle a pulse:PublicationTypeEnumeration ; skos:prefLabel "Journal Article"@en ; skos:definition "An article published in a peer-reviewed journal."@en ; skos:exactMatch coar-resource:c_6501 .
pulse:ConferencePaper a pulse:PublicationTypeEnumeration ; skos:prefLabel "Conference Paper"@en ; skos:definition "A paper presented at and published in the proceedings of a conference."@en ; skos:exactMatch coar-resource:c_5794 .
pulse:Preprint a pulse:PublicationTypeEnumeration ; skos:prefLabel "Preprint"@en ; skos:definition "A version of a paper made publicly available before formal peer review."@en ; skos:exactMatch coar-resource:c_816b .
pulse:BookChapter a pulse:PublicationTypeEnumeration ; skos:prefLabel "Book Chapter"@en ; skos:definition "A chapter published as part of an edited book."@en ; skos:exactMatch coar-resource:c_3248 .
pulse:Dissertation a pulse:PublicationTypeEnumeration ; skos:prefLabel "Dissertation"@en ; skos:definition "A thesis submitted in support of an academic degree."@en ; skos:closeMatch coar-resource:c_46ec .
pulse:Report a pulse:PublicationTypeEnumeration ; skos:prefLabel "Report"@en ; skos:definition "A technical or research report."@en ; skos:exactMatch coar-resource:c_93fc .
pulse:OtherPublicationType a pulse:PublicationTypeEnumeration ; skos:prefLabel "Other"@en ; skos:definition "A publication type that does not fit into the other categories."@en .

# Enumeration Instances - Access Rights
# skos:exactMatch/closeMatch align these with the COAR Access Rights vocabulary
# (https://vocabularies.coar-repositories.org/access_rights/), which OpenAIRE mandates.
pulse:OpenAccess a pulse:AccessRightEnumeration ; skos:prefLabel "Open Access"@en ; skos:definition "The publication is freely accessible to anyone."@en ; skos:exactMatch coar-access:c_abf2 .
pulse:ClosedAccess a pulse:AccessRightEnumeration ; skos:prefLabel "Closed Access"@en ; skos:definition "The publication is not publicly accessible."@en ; skos:closeMatch coar-access:c_14cb .
pulse:EmbargoedAccess a pulse:AccessRightEnumeration ; skos:prefLabel "Embargoed Access"@en ; skos:definition "The publication will become openly accessible after an embargo period."@en ; skos:exactMatch coar-access:c_f1cf .
pulse:RestrictedAccess a pulse:AccessRightEnumeration ; skos:prefLabel "Restricted Access"@en ; skos:definition "The publication is accessible only under certain conditions (e.g., registration, institutional access)."@en ; skos:exactMatch coar-access:c_16ec .

