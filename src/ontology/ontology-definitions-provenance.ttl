@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix pulse:  <https://open-pulse.epfl.ch/ontology#> .

# ---------------------------------------------------------
# PROVENANCE SCHEMA (graph:prov)
#
# Not SHACL-shaped, deliberately. Winner-links are recorded as RDF-star
# annotations directly on the quoted triple they explain — SHACL has
# no way to target a quoted triple as a focus node (pySHACL has no
# RDF-star support at all as of 0.40.0; rdflib can't even parse
# Turtle-star as of 7.6.0). This file exists purely to document the
# vocabulary and the exact triple patterns expected in graph:prov, so
# there's one structured reference for what to generate and query —
# it is not enforced by any tool in this repo.
# ---------------------------------------------------------

# ---------------------------------------------------------
# CLASSES
# ---------------------------------------------------------

pulse:ExtractionRun
    a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    skos:prefLabel "Extraction Run" ;
    skos:definition "One overall invocation of the extraction pipeline, potentially spanning multiple source platforms in a single batch (e.g. one run that hits GitHub, Hugging Face and Infoscience). Does not itself name a graph — each platform's output is a separate pulse:ExtractionOutput generated by this run." ;
    rdfs:comment """A run spanning two platforms, with its seeds and the tool version that produced it:
  pulse:Run1 a pulse:ExtractionRun ;
      prov:startedAtTime "2026-01-05T02:00:00"^^xsd:dateTime ;
      prov:endedAtTime "2026-01-05T02:14:00"^^xsd:dateTime ;
      pulse:extractionSeed "sdsc-ordes/open-pulse-ontology", "org/other-repo" ;
      pulse:extractedBy pulse:GitMetadataExtractor2_3_1 .

  pulse:GitMetadataExtractor2_3_1 a prov:SoftwareAgent ;
      schema:name "git-metadata-extractor" ;
      schema:softwareVersion "2.3.1" .

The SoftwareAgent is its own named resource, not inlined onto the run,
so every run that used version 2.3.1 shares the same IRI instead of
repeating the version string.""" .

pulse:ExtractionOutput
    a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel "Extraction Output" ;
    skos:definition "One platform's raw output within a single ExtractionRun — the named substrate graph of raw, per-source assertions that platform produced. The ExtractionOutput's own IRI is used as the named-graph IRI of that substrate graph." ;
    rdfs:comment """Two sibling outputs from the run above, one per platform:
  <raw:run1-github> a pulse:ExtractionOutput ;
      prov:wasGeneratedBy pulse:Run1 ;
      pulse:platform pulse:GitHub ;
      prov:generatedAtTime "2026-01-05T02:07:00"^^xsd:dateTime .

  <raw:run1-huggingface> a pulse:ExtractionOutput ;
      prov:wasGeneratedBy pulse:Run1 ;
      pulse:platform pulse:HuggingFace ;
      prov:generatedAtTime "2026-01-05T02:14:00"^^xsd:dateTime .

Sibling outputs from the same run are connected by sharing the same
prov:wasGeneratedBy target — not by nesting prov:Bundle. PROV bundles
cannot nest, and base PROV-O has no native bundle-to-bundle link (that
gap is what the separate PROV-LINKS spec exists for); wasGeneratedBy
is the native, correct way to relate several outputs to one shared
Activity.""" .

prov:Entity
    a rdfs:Class ;
    skos:prefLabel "Entity" ;
    skos:definition "A physical, digital, conceptual, or other kind of thing with some fixed aspects (PROV-O). ExtractionOutput and Observation are both entities." .

prov:Bundle
    a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel "Bundle" ;
    skos:definition "A named set of provenance descriptions (PROV-O) — reserved for graphs whose content IS provenance assertions, not arbitrary domain data. graph:prov itself is the one graph in this ontology that qualifies: its content is exactly the wasDerivedFrom winner-links and ExtractionRun/ExtractionOutput records. Raw substrate graphs (PlatformProfile/Repository/etc. facts) are ExtractionOutputs, not Bundles — typing them as prov:Bundle would misuse the term." ;
    rdfs:comment "Self-describing, like this ontology's own owl:Ontology header: <graph:prov> a prov:Bundle ." .

prov:SoftwareAgent
    a rdfs:Class ;
    rdfs:subClassOf prov:Agent ;
    skos:prefLabel "Software Agent" ;
    skos:definition "A software program (PROV-O). Represents one version of the extraction tool — e.g. git-metadata-extractor 2.3.1 — as its own named resource, so every ExtractionRun that used that version links to the same IRI instead of repeating the version string." .

# ---------------------------------------------------------
# RDF-STAR ANNOTATION PROPERTIES
#
# Each is asserted directly on the quoted triple it explains, not on
# a separate reified node — the quoted triple's own subject/predicate/
# object already carry what would otherwise need observedSubject/
# observedProperty/observedValue. Query pattern to find where a
# canonical value came from:
#
#   SELECT ?output ?kind ?confidence WHERE {
#     GRAPH <graph:canonical> { pulse:Jordan schema:name ?name }
#     GRAPH <graph:prov> {
#       << pulse:Jordan schema:name ?name >> prov:wasDerivedFrom ?output ;
#          pulse:observationKind ?kind ;
#          pulse:observationConfidence ?confidence .
#     }
#   }
# ---------------------------------------------------------

prov:wasDerivedFrom
    a rdf:Property ;
    skos:prefLabel "was derived from" ;
    skos:definition "Links a value to the source it was derived from." ;
    rdfs:comment "<< ?s ?p ?o >> prov:wasDerivedFrom ?output — the specific ExtractionOutput (one platform's raw graph) this quoted triple's value was read from, not the overall ExtractionRun." .

prov:wasGeneratedBy
    a rdf:Property ;
    skos:prefLabel "was generated by" ;
    skos:definition "Links an Entity to the Activity that produced it." ;
    rdfs:comment "<raw-graph-iri> prov:wasGeneratedBy <run-iri> — links an ExtractionOutput back to the ExtractionRun that produced it. Shared across sibling outputs from the same run." .

prov:startedAtTime
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "started at time" ;
    skos:definition "The time an Activity started." .

prov:endedAtTime
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "ended at time" ;
    skos:definition "The time an Activity ended." .

prov:generatedAtTime
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "generated at time" ;
    skos:definition "The time an Entity was generated." .

pulse:observationKind
    a rdf:Property ;
    rdfs:range xsd:string ;
    skos:prefLabel "observation kind" ;
    skos:definition "The value-selection rule that produced this quoted triple's winning value (e.g. 'single-source', 'highest-confidence')." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:observationKind \"highest-confidence\" ." .

pulse:observationConfidence
    a rdf:Property ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "observation confidence" ;
    skos:definition "A confidence score, between 0 and 1, for this quoted triple's value." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:observationConfidence \"0.92\"^^xsd:decimal ." .

pulse:observedOn
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "observed on" ;
    skos:definition "The timestamp this quoted triple's value was (re-)recorded." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:observedOn \"2026-01-05T02:10:00\"^^xsd:dateTime ." .

pulse:firstObservedOn
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "first observed on" ;
    skos:definition "The timestamp this value was first observed, across all runs." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:firstObservedOn \"2025-11-01T00:00:00\"^^xsd:dateTime — upserted, not appended." .

pulse:lastConfirmedOn
    a rdf:Property ;
    rdfs:range xsd:dateTime ;
    skos:prefLabel "last confirmed on" ;
    skos:definition "The timestamp this value was most recently re-observed." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:lastConfirmedOn \"2026-01-05T02:10:00\"^^xsd:dateTime — upserted on every re-confirmation." .

pulse:observationCount
    a rdf:Property ;
    rdfs:range xsd:integer ;
    skos:prefLabel "observation count" ;
    skos:definition "The number of times this value has been (re-)observed across runs." ;
    rdfs:comment "<< ?s ?p ?o >> pulse:observationCount 4 — a running counter, upserted, never one triple per observation." .

# ---------------------------------------------------------
# PLAIN TRIPLES (not RDF-star annotations)
# ---------------------------------------------------------

pulse:samePersonAs
    a rdf:Property ;
    rdfs:subPropertyOf owl:sameAs ;
    skos:prefLabel "same person as" ;
    skos:definition "Links two Person nodes the unifier has asserted are the same real-world individual." ;
    rdfs:comment "Plain triple in graph:prov, not a quoted-triple annotation: :person1 pulse:samePersonAs :person2 ." .

pulse:partOfRun
    a rdf:Property ;
    skos:prefLabel "part of run" ;
    skos:definition "Links a substrate-level resource (e.g. a PlatformProfile, a Contribution) to the specific ExtractionOutput that produced it — the platform-scoped output, not the overall multi-platform ExtractionRun." ;
    rdfs:comment "Plain triple, asserted on the raw entity itself, inside the ExtractionOutput graph it names, not in graph:prov: :someProfile pulse:partOfRun <raw-graph-iri> ." .

prov:wasAssociatedWith
    a rdf:Property ;
    skos:prefLabel "was associated with" ;
    skos:definition "Links an Activity to an Agent that had some responsibility for it (PROV-O). Use pulse:extractedBy, its subproperty, for ExtractionRun → SoftwareAgent — this generic term is declared for PROV-O interoperability, not for direct use." .

pulse:extractedBy
    a rdf:Property ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    skos:prefLabel "extracted by" ;
    skos:definition "Links an ExtractionRun to the SoftwareAgent (extractor tool version) that carried it out." ;
    rdfs:comment "pulse:Run1 pulse:extractedBy pulse:GitMetadataExtractor2_3_1 ." .

schema:softwareVersion
    a rdf:Property ;
    skos:prefLabel "software version" ;
    skos:definition "The version of the software instance." .

pulse:extractionSeed
    a rdf:Property ;
    rdfs:range xsd:string ;
    skos:prefLabel "extraction seed" ;
    skos:definition "One of the seed identifiers (e.g. a repository handle) an ExtractionRun was started from. Multi-valued — a run typically has many." ;
    rdfs:comment "pulse:Run1 pulse:extractionSeed \"owner/repo1\" , \"owner/repo2\" ." .
