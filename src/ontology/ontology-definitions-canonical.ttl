@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix pulse:     <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix datacite: <http://purl.org/spar/datacite/> .

# ---------------------------------------------------------
# CLASS & PROPERTY SECTION (semantic aspect)
# ---------------------------------------------------------

<https://open-pulse.epfl.ch/ontology#> a owl:Ontology ;
    dct:abstract "The Open Pulse Ontology to model contributions to open source scientific software and research articles from EPFL." ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    dct:title "Open Pulse Ontology" ;
    owl:versionInfo "v3.0.0-develop"^^xsd:string .

# Classes
schema:Person a rdfs:Class ; skos:prefLabel "Person" ; skos:definition "An individual researcher or contributor." .
schema:ScholarlyArticle a rdfs:Class ; skos:prefLabel "Scholarly Article" ; skos:definition "A research paper or publication." .
schema:SoftwareSourceCode a rdfs:Class ; skos:prefLabel "Software Repository" ; skos:definition "A software project or source code." .
schema:Project a rdfs:Class ; skos:prefLabel "Project" ; skos:definition "A collaborative research endeavor with a particular aim, typically time-bounded and funded, that produces research outputs such as software repositories and scholarly articles." .
org:Membership a rdfs:Class ; skos:prefLabel "Membership" ; skos:definition "An affiliation between a Person and an Organization." .
org:Organization a rdfs:Class ; skos:prefLabel "Organization" ; skos:definition "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures." .
pulse:Contribution a rdfs:Class ; skos:prefLabel "Contribution" ; skos:definition "Represents a person's aggregated contributions to a repository." .
pulse:PlatformProfile a rdfs:Class ; skos:prefLabel "Platform Profile" ; skos:definition "An identity that a Person holds on a specific external platform (e.g. a GitHub account or an Infoscience author record), grouping the platform-scoped handle, display name and email that belong together." .
pulse:OrganizationProfile a rdfs:Class ; skos:prefLabel "Organization Profile" ; skos:definition "An identity that an Organization holds on a specific external platform (e.g. a GitHub org or a Hugging Face org), grouping the platform-scoped handle, display name and URL that belong together." .
pulse:Deposit a rdfs:Class ; skos:prefLabel "Deposit" ; skos:definition "A specific instance of a ScholarlyArticle deposited or registered on one external platform (e.g. a Zenodo record, an Infoscience entry, an arXiv submission), grouping that platform's own internal ID, access right, publisher and publication date." .

# Properties
schema:license a rdf:Property ; skos:prefLabel "license" ; skos:definition "A license document that applies to this content, typically indicated by URL." .
schema:name a rdf:Property ; skos:prefLabel "name"; skos:definition "The name of the item." .
schema:email a rdf:Property ; skos:prefLabel "email" ; skos:definition "Email address." .
schema:url a rdf:Property ; skos:prefLabel "url" ; skos:definition "URL of the item." .
schema:identifier a rdf:Property ; skos:prefLabel "identifier" ; skos:definition "The identifier (URL/Text) property represents any kind of identifier for any kind of Thing" .
pulse:doi a rdf:Property ; rdfs:subPropertyOf schema:identifier ; skos:prefLabel "DOI" ; skos:definition "The Digital Object Identifier of a scholarly article." ; skos:exactMatch datacite:doi .
pulse:ror a rdf:Property ; rdfs:subPropertyOf schema:identifier ; skos:prefLabel "ROR identifier" ; skos:definition "The Research Organization Registry (ROR) identifier of an organization." ; skos:exactMatch datacite:ror .
schema:headline a rdf:Property ; skos:prefLabel "headline" ; skos:definition "The headline of the article." .
schema:programmingLanguage a rdf:Property ; skos:prefLabel "programming language" ; skos:definition "The computer programming language." .
schema:codeRepository a rdf:Property ; skos:prefLabel "code repository" ; skos:definition "Link to the repository where the un-compiled, human readable code and related code is located (SVN, GitHub, CodePlex)."   .
schema:dateCreated a rdf:Property ; skos:prefLabel "date created" ;  skos:definition "The date on which the CreativeWork was created or the item was added to a DataFeed." .
schema:datePublished a rdf:Property ; skos:prefLabel "date published" ; skos:definition "Date of first publication or broadcast" .
schema:author a rdf:Property ; skos:prefLabel "author" ; skos:definition "The author of this content or rating." .
schema:sourceOrganization a rdf:Property ; skos:prefLabel "source organization" ; skos:definition "The organization where the work was created or published." .
schema:publisher a rdf:Property ; skos:prefLabel "publisher" ; skos:definition "The entity that holds, archives, publishes, prints, distributes, releases, issues, or produces the resource (e.g. a journal publisher)." .
schema:description a rdf:Property ; skos:prefLabel "description" ; skos:definition "A description of the item." .
schema:citation a rdf:Property ; skos:prefLabel "citation" ; skos:definition "A citation or reference to a creative work such as a publication or dataset." .
schema:member a rdf:Property ; skos:prefLabel "member" ; skos:definition "A member of an Organization or a Project." .
schema:funder a rdf:Property ; skos:prefLabel "funder" ; skos:definition "An organization that supports (sponsors) something through some kind of financial contribution." .
org:hasUnit a rdf:Property ; skos:prefLabel "has unit"; skos:definition "Indicates a unit which is part of this Organization, e.g. a Department within a larger Organization.".
org:unitOf a rdf:Property ; skos:prefLabel "unit of"; skos:definition "Indicates an Organization of which this Unit is a part, e.g. a Department within a larger Organization.".
org:hasMembership a rdf:Property ; skos:prefLabel "has membership"; skos:definition "Indicates a membership relationship that the Agent plays." .
org:organization a rdf:Property ; skos:prefLabel "organization" ; skos:definition "Indicates the organization in which the agent is a member." .
org:role a rdf:Property ; skos:prefLabel "role"; skos:definition "Indicates the Role that the Agent plays in a Membership relationship with an Organization." .
time:hasBeginning a rdf:Property ; skos:prefLabel "has beginning" ; skos:definition "The beginning of the temporal entity." .
time:hasEnd a rdf:Property ; skos:prefLabel "has end" ; skos:definition "The end of the temporal entity." .
pulse:platformUsername a rdf:Property ; skos:prefLabel "platform username" ; skos:definition "The person's handle/username on an external platform (e.g. a GitHub login, a Hugging Face username, or an Infoscience person identifier), interpreted relative to pulse:platform." .
pulse:repositoryHandle a rdf:Property ; skos:prefLabel "repository handle" ; skos:definition "The handle of the repository (e.g. 'owner/repository' on GitHub/Bitbucket, or 'group/subgroup/project' on GitLab), interpreted relative to pulse:platform." .
pulse:organizationHandle a rdf:Property ; skos:prefLabel "organization handle" ; skos:definition "The handle/slug of the organization on an external platform (e.g. a GitHub login, a Hugging Face org slug, or an Infoscience organization UUID), interpreted relative to pulse:platform." .
pulse:platformInternalId a rdf:Property ; skos:prefLabel "platform internal ID" ; skos:definition "The stable, platform-issued internal identifier for this resource (e.g. a GitHub user/org/repo numeric ID, a Hugging Face internal ID, or an Infoscience/Zenodo record ID), interpreted relative to pulse:platform. Unlike a username or handle, this value does not change if the resource is renamed." .
pulse:platformNodeId a rdf:Property ; skos:prefLabel "platform node ID" ; skos:definition "A platform's own opaque global node identifier for this resource (e.g. a GitHub GraphQL node ID), interpreted relative to pulse:platform." .
pulse:discipline a rdf:Property ; skos:prefLabel "discipline" ; skos:definition "The academic or scientific discipline associated with the resource." .
pulse:repositoryType a rdf:Property ; skos:prefLabel "repository type" ; skos:definition "The type or category of the repository (e.g., software, data, publication)." .
pulse:OrganizationType a rdf:Property ; skos:prefLabel "organization type" ; skos:definition "The type or category of the organization (e.g., university, research institute, company)." .
pulse:repositoryStars a rdf:Property ; rdfs:range xsd:integer ; skos:prefLabel "repository stars" ; skos:definition "The number of stars a repository has received." .
pulse:repositoryForks a rdf:Property ; rdfs:range xsd:integer ; skos:prefLabel "repository forks" ; skos:definition "The number of forks (copies) of a repository." .

# Ownership and contribution properties
pulse:owns a rdf:Property ; skos:prefLabel "owns" ; skos:definition "Links a Person or Organization to a software repository they own." ; owl:inverseOf pulse:ownedBy .
pulse:ownedBy a rdf:Property ; skos:prefLabel "owned by" ; skos:definition "Links a software repository to its owning Person or Organization." .
pulse:isForkOf a rdf:Property ; skos:prefLabel "is fork of" ; skos:definition "Links a repository to the parent-repository it was forked from." ; rdfs:domain schema:SoftwareSourceCode ; rdfs:range schema:SoftwareSourceCode .
pulse:hasContribution a rdf:Property ; skos:prefLabel "has contribution" ; skos:definition "Links a Person to a Contribution they made to a repository." .
pulse:contributionTo a rdf:Property ; skos:prefLabel "contribution to" ; skos:definition "Links a Contribution to the Repository it belongs to." ; rdfs:domain pulse:Contribution ; rdfs:range schema:SoftwareSourceCode .
pulse:contributionCount a rdf:Property ; rdfs:range xsd:integer ; skos:prefLabel "contribution count" ; skos:definition "The number of contributions (commits) made." .
pulse:firstContributionDate a rdf:Property ; rdfs:range xsd:dateTime ; skos:prefLabel "first contribution date" ; skos:definition "The date of the first contribution." .
pulse:lastContributionDate a rdf:Property ; rdfs:range xsd:dateTime ; skos:prefLabel "last contribution date" ; skos:definition "The date of the most recent contribution." .
pulse:gitAuthorName a rdf:Property ; skos:prefLabel "git author name" ; skos:definition "The author name as it literally appears in the aggregated git commits, which may differ from the person's current platform profile name." .
pulse:gitAuthorEmail a rdf:Property ; skos:prefLabel "git author email" ; skos:definition "The author email as it literally appears in the aggregated git commits, which may differ from the person's current platform profile email." .
pulse:orcidIdentifier a rdf:Property ; skos:prefLabel "ORCID identifier" ; skos:definition "The ORCID identifier for a person." ; skos:exactMatch datacite:orcid .

# Platform profile properties
pulse:hasProfile a rdf:Property ; skos:prefLabel "has profile" ; skos:definition "Links a Person to a platform profile (external account/identity) they hold." .
pulse:profileOf a rdf:Property ; skos:prefLabel "profile of" ; skos:definition "Links a platform profile back to the Person it belongs to." .
pulse:hasOrganizationProfile a rdf:Property ; skos:prefLabel "has organization profile" ; skos:definition "Links an Organization to a platform profile (external account/identity) it holds." .
pulse:organizationProfileOf a rdf:Property ; skos:prefLabel "organization profile of" ; skos:definition "Links a platform profile back to the Organization it belongs to." .
pulse:platform a rdf:Property ; rdfs:range pulse:PlatformEnumeration ; skos:prefLabel "platform" ; skos:definition "The external platform associated with this resource (e.g. the platform a PlatformProfile/OrganizationProfile exists on, or the platform hosting a repository)." .

# Project properties
pulse:projectOutput a rdf:Property ; skos:prefLabel "project output" ; skos:definition "Links a Project to a research output (software repository or scholarly article) produced by the project." .

# Publication properties
pulse:publicationType a rdf:Property ; skos:prefLabel "publication type" ; skos:definition "The type or category of the publication (e.g., journal article, conference paper, preprint)." .
pulse:accessRight a rdf:Property ; skos:prefLabel "access right" ; skos:definition "The open-access status of the publication (e.g., open, closed, embargoed, restricted)." .

# Deposit properties
pulse:hasDeposit a rdf:Property ; skos:prefLabel "has deposit" ; skos:definition "Links a ScholarlyArticle to a platform-specific deposit or registration of it (e.g. its Zenodo record, its Infoscience entry, its arXiv submission)." .
pulse:depositOf a rdf:Property ; skos:prefLabel "deposit of" ; skos:definition "Links a Deposit back to the ScholarlyArticle it is a deposit of." .

# Authorship properties
pulse:hasAuthoredArticle a rdf:Property ; skos:prefLabel "has authored article" ; skos:definition "Links a Person to a ScholarlyArticle they authored." ; owl:inverseOf schema:author .
