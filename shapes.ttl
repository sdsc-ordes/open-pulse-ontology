prefix schema: <http://schema.org/>
prefix sd: <https://w3id.org/okn/o/sd#>
prefix bio: <https://bioschemas.org/>
prefix spe: <https://openschemas.github.io/spec-container/specifications/>
prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix sh:   <http://www.w3.org/ns/shacl#>
prefix xsd:  <http://www.w3.org/2001/XMLSchema#>
prefix shsh: <http://www.w3.org/ns/shacl-shacl#>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix dcterms: <http://purl.org/dc/terms/>
prefix pulse: <https://open-pulse.epfl.ch/ontology#>
prefix md4i: <http://w3id.org/nfdi4ing/metadata4ing#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix dct: <http://purl.org/dc/terms/>
prefix vann: <http://purl.org/vocab/vann/>
prefix sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
prefix dmib: <https://biomedit.ch/rdf/sphn-schema/dmib#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>

prefix wd: <http://www.wikidata.org/entity/> 
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> 
prefix sesame: <http://www.openrdf.org/schema/sesame#> 
prefix owl: <http://www.w3.org/2002/07/owl#> 
prefix xsd: <http://www.w3.org/2001/XMLSchema#> 
prefix fn: <http://www.w3.org/2005/xpath-functions#>

<https://open-pulse.epfl.ch/ontology#>
	a owl:Ontology ;
	sh:entailment sh:Rules ;
	sh:declare [
		sh:prefix "pulse" ;
		sh:namespace <https://open-pulse.epfl.ch/ontology#> ;
	] .

schema:SoftwareSourceCode
a sh:NodeShape, rdfs:Class ;
sh:property   schema:CreativeWork-citation ,
              schema:SoftwareSourceCode-codeRepository ,
              schema:CreativeWork-dateCreated ,
              schema:CreativeWork-datePublished ,
              schema:Thing-description ,
              pulse:relatedToOrganizationShape, 
              schema:CreativeWork-license ,
              schema:CreativeWork-author ,
              schema:Thing-name ,
              schema:SoftwareSourceCode-programmingLanguage ,
              schema:Thing-url ,
              schema:Thing-identifier ,
              sd:SoftwareApplication-readme , 
              pulse:disciplineShape ,
              pulse:repositoryTypeShape ,
              pulse:hasAcademicCatalogRelationShape ,
              pulse:relatedToEPFLShape ,
              pulse:sourceShape ,
              pulse:linkedEntitiesShape ,
              pulse:relatedModelsShape ,
              pulse:firstCommitDateShape ,
              pulse:lastCommitDateShape ,
              pulse:gitAuthorsShape ,
              pulse:relatedPublicationsShape ,
              pulse:relatedAPIsShape ,
              pulse:relatedDatasetsShape ,
              pulse:totalCommitsShape ,
              pulse:commitsShape ,
              pulse:metadataShape
.

schema:CreativeWork-citation
  a sh:PropertyShape ;
  sh:path schema:citation ;
  sh:minCount 1 ;
  sh:datatype xsd:string ;
  sh:pattern "^http.*" ;
.

schema:SoftwareSourceCode-codeRepository
  a sh:PropertyShape ;
  sh:path schema:codeRepository ;
  sh:pattern "^http.*" ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
.
        

schema:CreativeWork-dateCreated
  a sh:PropertyShape ;
  sh:path schema:dateCreated ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:datatype xsd:date ;
  .

schema:CreativeWork-datePublished
  a sh:PropertyShape ;
  sh:path schema:datePublished ;
  sh:datatype xsd:date ;  
  sh:minCount 1 ;
.

schema:Thing-description
  a sh:PropertyShape ;
  sh:path schema:description ;
  sh:datatype xsd:string ;
  sh:maxLength 2000 ;
  sh:minCount 1 ;
.

pulse:relatedToOrganizationShape
  a sh:PropertyShape ;
  sh:path pulse:relatedToOrganization ;
  sh:datatype xsd:string ;
  .

schema:CreativeWork-license
  a sh:PropertyShape ;
  sh:path schema:license ;
  sh:pattern ".*spdx\\.org.*" ;
  sh:minCount 1 ;
.

schema:CreativeWork-author
  a sh:PropertyShape ;
  sh:path schema:author ;
  sh:minCount 1 ;
  sh:or (
      [
        sh:class schema:Organization ;
      ]
      [
        sh:class schema:Person ;
      ]
    ) ;
.

schema:Person
a sh:NodeShape ;
  sh:property schema:Thing-name ;
  sh:property md4i:orcidIdShape ;
  sh:property schema:Thing-affiliation ;
  sh:property pulse:usernameShape ;
  sh:property schema:memberOfShape 
.

schema:Person-familyName
  a sh:PropertyShape ;
  sh:path schema:familyName ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
  .

schema:Person-givenName
  a sh:PropertyShape ;
  sh:path schema:givenName ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
.

md4i:orcidIdShape
  a sh:PropertyShape ;
  sh:path md4i:orcidId ;
  sh:datatype xsd:string ;
  .

schema:Thing-affiliation
  a sh:PropertyShape ;
  sh:path schema:affiliation ;
  sh:datatype xsd:string ;
.

schema:Organization
  a sh:NodeShape ;
sh:property schema:Organization-legalName ;
sh:property md4i:hasRorIdShape ;
.

schema:GitHubOrganization
  a sh:NodeShape ;
sh:property pulse:usernameShape ;
sh:property pulse:hasRepositoryShape ;
sh:property schema:Thing-affiliation ;
.

schema:ScholarlyArticle
  a sh:NodeShape, rdfs:Class ;
sh:property schema:Thing-name ;
sh:property schema:Thing-description ;
sh:property schema:CreativeWork-author ;
sh:property schema:CreativeWork-dateCreated ;
sh:property schema:CreativeWork-datePublished ;
sh:property schema:Thing-identifier ;
sh:property schema:Thing-url ;
.

schema:Dataset
  a sh:NodeShape, rdfs:Class ;
sh:property schema:Thing-name ;
sh:property schema:Thing-description ;
sh:property schema:Thing-url ;
.

schema:Thing-name
  a sh:PropertyShape ;
  sh:path schema:name ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
  sh:maxLength 60
.

schema:SoftwareSourceCode-programmingLanguage
  a sh:PropertyShape ;
  sh:path schema:programmingLanguage ;
  sh:datatype xsd:string ;
.

schema:Thing-url
  a sh:PropertyShape ;
  sh:path schema:url ;
  sh:pattern "^http.*" ;
.

sd:SoftwareApplication-hasAcknowledgements
    a sh:PropertyShape ;
    sh:path sd:hasAcknowledgements ;
    sh:datatype xsd:string ;
    .

sd:SoftwareApplication-readme
    a sh:PropertyShape ;
    sh:path sd:readme ;
    sh:pattern "^http.*" ;
  .

schema:DataDownload-contentURL
  a sh:PropertyShape ;
  sh:path schema:contentUrl ;
  sh:pattern "^http.*" ;
  sh:minCount 1 ;
  .
    

schema:Thing-identifier
  a sh:PropertyShape ;
  sh:path schema:identifier ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
.


schema:Organization-legalName
  a sh:PropertyShape ;
  sh:path schema:legalName ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
.

md4i:hasRorIdShape
  a sh:PropertyShape ;
  sh:path md4i:hasRorId ;
  sh:pattern "^http.*" ;
  .

pulse:disciplineShape
    a sh:PropertyShape ;
    sh:path pulse:discipline ;
    sh:datatype xsd:string ;
    sh:class pulse:DisciplineEnumeration ;
    .


pulse:repositoryTypeShape
    a sh:PropertyShape ;
    sh:path pulse:repositoryType ;
    sh:class pulse:RepositoryTypeEnumeration
    .


pulse:usernameShape
    a sh:PropertyShape ;
    sh:path schema:username ;
    sh:datatype xsd:string ;
    .

pulse:hasRepositoryShape
    a sh:PropertyShape ;
    sh:path pulse:hasRepository ;
    sh:class schema:SoftwareSourceCode ;
    .

schema:memberOfShape 
    a sh:PropertyShape ;
    sh:path schema:memberOf ;
    sh:class schema:GitHubOrganization ;
    .
# Academic Catalog Relation Shapes

pulse:AcademicCatalogRelation
    a sh:NodeShape, rdfs:Class ;
    sh:property pulse:catalogTypeShape ,
                pulse:entityTypeShape ,
                pulse:hasCatalogEntityShape ,
                pulse:confidenceShape ,
                pulse:justificationShape ,
                pulse:externalIdShape ,
                pulse:matchedOnShape .

pulse:catalogTypeShape
    a sh:PropertyShape ;
    sh:path pulse:catalogType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "infoscience" "orcid" "ror" "wikidata" ) .

pulse:entityTypeShape
    a sh:PropertyShape ;
    sh:path pulse:entityType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "person" "organization" "publication" "project" ) .

pulse:hasCatalogEntityShape
    a sh:PropertyShape ;
    sh:path pulse:hasCatalogEntity ;
    sh:class pulse:CatalogEntity ;
    sh:minCount 1 ;
    sh:maxCount 1 .

pulse:confidenceShape
    a sh:PropertyShape ;
    sh:path pulse:confidence ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 1.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

pulse:externalIdShape
    a sh:PropertyShape ;
    sh:path pulse:externalId ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

pulse:matchedOnShape
    a sh:PropertyShape ;
    sh:path pulse:matchedOn ;
    sh:datatype xsd:string .

# Catalog Entity Shape

pulse:CatalogEntity
    a sh:NodeShape, rdfs:Class ;
    sh:property pulse:uuidShape ,
                schema:Thing-name ,
                pulse:emailShape ,
                md4i:orcidIdShape ,
                schema:Thing-affiliation ,
                pulse:profileUrlShape .
pulse:uuidShape
    a sh:PropertyShape ;
    sh:path pulse:uuid ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

pulse:emailShape
    a sh:PropertyShape ;
    sh:path pulse:email ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

pulse:profileUrlShape
    a sh:PropertyShape ;
    sh:path pulse:profileUrl ;
    sh:datatype xsd:anyURI ;
    sh:pattern "^http.*" ;
    sh:maxCount 1 .

pulse:hasAcademicCatalogRelationShape
    a sh:PropertyShape ;
    sh:path pulse:hasAcademicCatalogRelation ;
    sh:class pulse:AcademicCatalogRelation .

# Additional Property Shapes for SoftwareSourceCode

pulse:relatedToEPFLShape
    a sh:PropertyShape ;
    sh:path pulse:relatedToEPFL ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

pulse:sourceShape
    a sh:PropertyShape ;
    sh:path pulse:source ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

pulse:linkedEntitiesShape
    a sh:PropertyShape ;
    sh:path pulse:linkedEntities ;
    sh:datatype xsd:string .

pulse:relatedModelsShape
    a sh:PropertyShape ;
    sh:path pulse:relatedModels ;
    sh:datatype xsd:string .

pulse:firstCommitDateShape
    a sh:PropertyShape ;
    sh:path pulse:firstCommitDate ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .

pulse:lastCommitDateShape
    a sh:PropertyShape ;
    sh:path pulse:lastCommitDate ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .

pulse:gitAuthorsShape
    a sh:PropertyShape ;
    sh:path pulse:gitAuthors ;
    sh:class schema:Person .

pulse:relatedPublicationsShape
    a sh:PropertyShape ;
    sh:path pulse:relatedPublications ;
    sh:class schema:ScholarlyArticle .

pulse:relatedAPIsShape
    a sh:PropertyShape ;
    sh:path pulse:relatedAPIs ;
    sh:datatype xsd:string .

pulse:relatedDatasetsShape
    a sh:PropertyShape ;
    sh:path pulse:relatedDatasets ;
    sh:class schema:Dataset .

pulse:totalCommitsShape
    a sh:PropertyShape ;
    sh:path pulse:totalCommits ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 .

pulse:commitsShape
    a sh:PropertyShape ;
    sh:path pulse:commits ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 .

pulse:metadataShape
    a sh:PropertyShape ;
    sh:path pulse:metadata ;
    sh:datatype xsd:string .

pulse:justificationShape
    a sh:PropertyShape ;
    sh:path pulse:justification ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

pulse:DisciplineEnumeration
    a sh:NodeShape, rdfs:Class ;
    rdfs:label "Discipline Enumeration" ;
    rdfs:comment "Enumeration of disciplines for categorizing software repositories." ;
    rdfs:subClassOf schema:Enumeration ;
    .

pulse:RepositoryTypeEnumeration
    a sh:NodeShape, rdfs:Class ;
    rdfs:label "Repository Type Enumeration" ;
    rdfs:comment "Enumeration of types of repositories." ;
    rdfs:subClassOf schema:Enumeration ;
    .

pulse:Software a pulse:RepositoryTypeEnumeration ;
    rdfs:label "Software" ;
    rdfs:comment "A repository that contains software source code." .

pulse:EducationalResource a pulse:RepositoryTypeEnumeration ;
    rdfs:label "Educational Resource" ;
    rdfs:comment "A repository that contains educational materials." .

pulse:Documentation a pulse:RepositoryTypeEnumeration ;
    rdfs:label "Documentation" ;
    rdfs:comment "A repository that contains documentation." .

pulse:Data a pulse:RepositoryTypeEnumeration ;
    rdfs:label "Data" ;
    rdfs:comment "A repository that contains datasets." .

pulse:Other a pulse:RepositoryTypeEnumeration ;
    rdfs:label "Other" ;
    rdfs:comment "A repository that does not fit into the other categories." .

