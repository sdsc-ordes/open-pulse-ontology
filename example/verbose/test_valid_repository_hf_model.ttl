@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pulse:HuggingFace a pulse:PlatformEnumeration .
pulse:Model a pulse:RepositoryTypeEnumeration .

# VALID - a Hugging Face Model: schema:SoftwareSourceCode with pulse:repositoryType pulse:Model.

pulse:HfModelAuthor a schema:Person ;
    schema:name "Model Author" ;
    pulse:hasProfile [ a pulse:PlatformProfile ; pulse:platform pulse:HuggingFace ; pulse:platformUsername "modelauthor" ] .

pulse:VerboseTranslationModel a schema:SoftwareSourceCode ;
    schema:name "verbose-lab/en-fr-translator" ;
    schema:dateCreated "2024-02-10T00:00:00"^^xsd:dateTime ;
    pulse:repositoryHandle "verbose-lab/en-fr-translator" ;
    pulse:platform pulse:HuggingFace ;
    pulse:repositoryType pulse:Model ;
    schema:author pulse:HfModelAuthor ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    pulse:readme <https://huggingface.co/verbose-lab/en-fr-translator/blob/main/README.md> ;
    pulse:pipelineTag "translation" ;
    pulse:task "translation" ;
    pulse:library "transformers" ;
    pulse:framework "pytorch" ;
    pulse:language "en" , "fr" ;
    pulse:downloadCount 15234 ;
    pulse:likeCount 87 ;
    pulse:gated false ;
    schema:dateModified "2026-05-30T00:00:00"^^xsd:dateTime .
