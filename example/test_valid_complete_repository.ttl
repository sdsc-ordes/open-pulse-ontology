@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
wd:Q2329 a pulse:DisciplineEnumeration .
pulse:Software a pulse:RepositoryTypeEnumeration .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration .

# VALID COMPLETE REPOSITORY - Should PASS validation
# This is a comprehensive example with all optional properties correctly set

pulse:CompleteRepo a schema:SoftwareSourceCode ;
    schema:name "Complete Research Software" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/epfl/research-software> ;
    schema:license <https://spdx.org/licenses/BSD-3-Clause.html> ;
    schema:citation <https://doi.org/10.5281/zenodo.1234567> ;
    schema:programmingLanguage "Python" ;
    pulse:githubRepoStars "128"^^xsd:integer ;
    pulse:githubRepoForks "14"^^xsd:integer ;
    schema:author pulse:LeadResearcher ;
    pulse:ownedBy pulse:EPFLLab ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q2329 .  # Chemistry

pulse:LeadResearcher a schema:Person ;
    schema:name "Dr. Sarah Smith" ;
    schema:email "sarah.smith@epfl.ch" ;
    pulse:gitUsername "sarahsmith" ;
    pulse:infoscienceUsername "sarah.smith" ;
    pulse:orcidIdentifier "0000-0001-5109-3700" ;
    schema:url <https://people.epfl.ch/sarah.smith> ;
    pulse:hasContribution pulse:SarahContribution ;
    org:hasMembership pulse:Membership1 .

pulse:SarahContribution a pulse:Contribution ;
    schema:author pulse:LeadResearcher ;
    pulse:contributionTo pulse:CompleteRepo ;
    pulse:contributionCount "256"^^xsd:integer ;
    pulse:firstContributionDate "2024-01-10T09:00:00"^^xsd:dateTime ;
    pulse:lastContributionDate "2024-12-15T17:30:00"^^xsd:dateTime .

pulse:Membership1 a org:Membership ;
    org:organization pulse:EPFLLab ;
    org:role "Principal Investigator" ;
    time:hasBeginning "2020-01-01"^^xsd:date ;
    time:hasEnd "2025-12-31"^^xsd:date .

pulse:EPFLLab a org:Organization ;
    schema:name "EPFL Computational Lab" ;
    schema:identifier "https://ror.org/02s376052" ;
    schema:url <https://github.com/DeepLabCut> ;
    pulse:OrganizationType pulse:ResearchInstitution ;
    pulse:githubOrgFollowers "320"^^xsd:integer ;
    pulse:owns pulse:CompleteRepo .
