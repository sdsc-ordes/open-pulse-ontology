@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pulse:GitHub a pulse:PlatformEnumeration .

# INVALID PLATFORM PROFILE - Should FAIL validation
# Email doesn't match the required pattern, pulse:ProfileEmailShape has pattern "^[\\w\\-\\.\\+]+@([\\w-]+\\.)+[\\w-]{2,}$"

pulse:InvalidEmailRepo a schema:SoftwareSourceCode ;
    schema:name "Invalid Email Test" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    pulse:repositoryHandle "example/invalid-email" ;
    pulse:platform pulse:GitHub ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:author pulse:InvalidEmailPerson .

pulse:InvalidEmailPerson a schema:Person ;
    schema:name "Bob Invalid" ;
    pulse:orcidIdentifier "0000-0002-1825-0097" ;
    pulse:hasProfile pulse:InvalidEmailProfile .

pulse:InvalidEmailProfile a pulse:PlatformProfile ;
    pulse:platform pulse:GitHub ;
    pulse:platformUsername "bobinvalid" ;
    schema:email "not-a-valid-email" .
