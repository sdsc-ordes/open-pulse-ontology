@prefix schema: <http://schema.org/> .
@prefix ex: <http://example.org/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
ex:Software a ex:RepositoryTypeEnumeration .
wd:Q395 a ex:DisciplineEnumeration .
ex:ResearchInstitution a ex:OrganizationTypeEnumeration .

# INVALID TEMPORAL ALIGNMENT - Should FAIL validation
# Membership interval is independent of commit timing

ex:InvalidTemporalRepo a schema:SoftwareSourceCode ;
    schema:name "Temporal Misaligned Repo" ;
    schema:dateCreated "2024-02-01T08:00:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/epfl/temporal-misaligned> ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.temporal> ;
    schema:programmingLanguage "Scala" ;
    schema:programmingLanguage "Python" ;
    schema:programmingLanguage "C++" ;
    ex:relatedToEPFL true ;
    schema:creator ex:TemporalAuthor ;
    ex:managedBy ex:TemporalLab ;
    ex:repositoryType ex:Software ;
    ex:discipline wd:Q395 ;  # Mathematics
    ex:hasCommit ex:LateCommit .

ex:TemporalAuthor a schema:Person ;
    schema:name "Alex Temporal" ;
    schema:email "alex.temporal@epfl.ch" ;
    ex:gitUsername "alextemporal" ;
    org:hasMembership ex:BrokenMembership .

ex:BrokenMembership a org:Membership ;
    org:organization ex:TemporalLab ;
    org:role "Contributor" ;
    time:hasBeginning "2024-06-01"^^xsd:date ;
    time:hasEnd "2024-07-01"^^xsd:date . 

ex:TemporalLab a org:Organization ;
    schema:name "EPFL Temporal Lab" ;
    schema:identifier "https://ror.org/02s376052" ;
    schema:url <https://www.epfl.ch/labs/temporal> ;
    ex:OrganizationType ex:ResearchInstitution ;
    ex:githubOrgUrl <https://github.com/epfl-temporal> ;
    ex:managedRepository ex:InvalidTemporalRepo .

ex:LateCommit a ex:GitCommit ;
    schema:identifier "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2" ;
    schema:dateCreated "2024-07-15T12:00:00"^^xsd:dateTime ;
    schema:author ex:TemporalAuthor .
