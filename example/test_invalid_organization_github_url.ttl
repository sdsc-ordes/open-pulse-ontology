@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pulse:GitHub a pulse:PlatformEnumeration .

# INVALID ORGANIZATION - Should FAIL validation
# Organization githubOrganizationHandle should be a simple string handle, not a URL or IRI

pulse:InvalidGithubUrlRepo a schema:SoftwareSourceCode ;
    schema:name "Invalid GitHub URL Test" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    pulse:githubRepositoryHandle "example/test-repo" ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:author pulse:GithubUrlAuthor ;
    pulse:ownedBy pulse:InvalidGithubOrg .

pulse:GithubUrlAuthor a schema:Person ;
    schema:name "Github URL Test Author" ;
    pulse:orcidIdentifier "0000-0006-7890-1234" ;
    pulse:hasProfile pulse:GithubUrlAuthorGitHubProfile .

pulse:GithubUrlAuthorGitHubProfile a pulse:PlatformProfile ;
    pulse:platform pulse:GitHub ;
    pulse:githubUsername "githubauthor" ;
    schema:email "github@example.com" .

pulse:InvalidGithubOrg a org:Organization ;
    schema:name "Invalid GitHub Org" ;
    pulse:ror "https://ror.org/012345678" ;
    pulse:githubOrganizationHandle <https://github.com/example-org> .  # Invalid: should be a string literal \"example-org\", not an IRI