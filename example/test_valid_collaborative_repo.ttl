@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
pulse:Software a pulse:RepositoryTypeEnumeration .
wd:Q420 a pulse:DisciplineEnumeration .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration .
pulse:GitHub a pulse:PlatformEnumeration .

# VALID COLLABORATIVE REPOSITORY - Should PASS validation
# Two contributors with memberships

pulse:CollabRepo a schema:SoftwareSourceCode ;
    schema:name "Collaborative EPFL Toolkit" ;
    schema:dateCreated "2024-06-15T10:00:00"^^xsd:dateTime ;
    pulse:repositoryHandle "epfl/collab-toolkit" ;
    pulse:platform pulse:GitHub ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:citation <https://doi.org/10.9999/example.collab> ;
    schema:programmingLanguage "Python" ;
    schema:programmingLanguage "C++" ;
    schema:programmingLanguage "Javascript" ;
    pulse:repositoryStars "45"^^xsd:integer ;
    pulse:repositoryForks "6"^^xsd:integer ;
    schema:author pulse:LeadDev ;
    schema:author pulse:Contributor ;
    pulse:ownedBy pulse:EPFLCenter ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q420 .  # Biology

pulse:LeadDev a schema:Person ;
    schema:name "Dr. Lina Morel" ;
    pulse:orcidIdentifier "0000-0003-1234-5678" ;
    pulse:hasProfile pulse:LeadDevGitHubProfile ;
    org:hasMembership pulse:LeadMembership .

pulse:LeadDevGitHubProfile a pulse:PlatformProfile ;
    pulse:platform pulse:GitHub ;
    pulse:platformUsername "linam" ;
    schema:email "lina.morel@epfl.ch" ;
    schema:url <https://people.epfl.ch/lina.morel> .

pulse:Contributor a schema:Person ;
    schema:name "Marco Ruiz" ;
    pulse:orcidIdentifier "0000-0002-9876-5432" ;
    pulse:hasProfile pulse:ContributorGitHubProfile ;
    org:hasMembership pulse:ContributorMembership .

pulse:ContributorGitHubProfile a pulse:PlatformProfile ;
    pulse:platform pulse:GitHub ;
    pulse:platformUsername "marcor" ;
    schema:email "marco.ruiz@epfl.ch" .

pulse:LeadMembership a org:Membership ;
    org:organization pulse:EPFLCenter ;
    org:role "Principal Investigator" ;
    time:hasBeginning "2022-01-01"^^xsd:date ;
    time:hasEnd "2025-12-31"^^xsd:date .

pulse:ContributorMembership a org:Membership ;
    org:organization pulse:EPFLCenter ;
    org:role "Research Engineer" ;
    time:hasBeginning "2024-03-01"^^xsd:date ;
    time:hasEnd "2024-12-31"^^xsd:date .

pulse:EPFLCenter a org:Organization ;
    schema:name "EPFL Center for Systems Biology" ;
    pulse:ror "https://ror.org/02s376052" ;
    pulse:hasOrganizationProfile pulse:EPFLCenterGitHubProfile ;
    pulse:OrganizationType pulse:ResearchInstitution ;
    pulse:owns pulse:CollabRepo .

pulse:EPFLCenterGitHubProfile a pulse:OrganizationProfile ;
    pulse:platform pulse:GitHub ;
    pulse:organizationHandle "DeepLabCut" .
