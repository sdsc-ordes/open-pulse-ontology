@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# INVALID GIT COMMIT - Should FAIL validation
# Git commit hash doesn't match pattern, pulse:GitHashShape has pattern "^([0-9a-f]{7}|[0-9a-f]{40})$"

pulse:InvalidCommitRepo a schema:SoftwareSourceCode ;
    schema:name "Invalid Commit Test" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/example/invalid-commit> ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:author pulse:CommitAuthor .

pulse:CommitAuthor a schema:Person ;
    schema:name "Dave Developer" ;
    schema:email "dave@example.com" ;
    pulse:gitUsername "davedeveloper" ;
    pulse:orcidIdentifier "0000-0003-4567-8901" .
