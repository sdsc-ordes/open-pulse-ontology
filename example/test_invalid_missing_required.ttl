@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# INVALID REPOSITORY - Should FAIL validation
# Missing required properties:
# - schema:author (required, minCount 1)
# - schema:name (required, minCount 1)

pulse:InvalidMissingRequired a schema:SoftwareSourceCode ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    pulse:githubRepositoryHandle "example/invalid-repo" ;
    schema:programmingLanguage "Python" .

pulse:InvalidPerson a schema:Person ;
    schema:email "invalid@example.com" ;
    pulse:githubUsername "invaliduser" ;
    pulse:orcidIdentifier "0000-0008-9012-3456" ;
    schema:name "Invalid Person" .
