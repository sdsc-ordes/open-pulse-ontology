@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ============================================================
# ENUMERATIONS (used in the data)
# ============================================================

wd:Q413 a pulse:DisciplineEnumeration ; skos:prefLabel "Physics" .
wd:Q420 a pulse:DisciplineEnumeration ; skos:prefLabel "Biology" .
wd:Q2329 a pulse:DisciplineEnumeration ; skos:prefLabel "Chemistry" .
wd:Q395 a pulse:DisciplineEnumeration ; skos:prefLabel "Mathematics" .

pulse:Software a pulse:RepositoryTypeEnumeration .
pulse:Data a pulse:RepositoryTypeEnumeration .

pulse:University a pulse:OrganizationTypeEnumeration .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration .
pulse:SoftwareProject a pulse:OrganizationTypeEnumeration .

pulse:GitHub a pulse:PlatformEnumeration .
pulse:Infoscience a pulse:PlatformEnumeration .

pulse:JournalArticle a pulse:PublicationTypeEnumeration .
pulse:ConferencePaper a pulse:PublicationTypeEnumeration .
pulse:Preprint a pulse:PublicationTypeEnumeration .

pulse:OpenAccess a pulse:AccessRightEnumeration .
pulse:ClosedAccess a pulse:AccessRightEnumeration .

# ============================================================
# ORGANIZATIONS
# ============================================================

# Organization 1: EPFL Computational Lab
pulse:EPFLComputationalLab a org:Organization ;
    schema:name "EPFL Computational Lab" ;
    pulse:ror "https://ror.org/02s376052" ;
    pulse:hasOrganizationProfile [ a pulse:OrganizationProfile ; pulse:platform pulse:GitHub ; pulse:organizationHandle "epfl-complab" ] ;
    pulse:OrganizationType pulse:ResearchInstitution ;
    pulse:githubOrgFollowers "450"^^xsd:integer ;
    pulse:owns pulse:SimulationFramework ;
    pulse:owns pulse:DataProcessing .

# Organization 2: Swiss Research Alliance
pulse:SwissResearchAlliance a org:Organization ;
    schema:name "Swiss Research Alliance" ;
    pulse:ror "https://ror.org/01wyqb977" ;
    pulse:hasOrganizationProfile [ a pulse:OrganizationProfile ; pulse:platform pulse:GitHub ; pulse:organizationHandle "swiss-research" ] ;
    pulse:OrganizationType pulse:ResearchInstitution ;
    pulse:githubOrgFollowers "230"^^xsd:integer ;
    pulse:owns pulse:NetworkAnalysis ;
    pulse:owns pulse:SimulationFramework .

# Organization 3: Department of Physics (university)
pulse:DepartmentPhysics a org:Organization ;
    schema:name "Department of Physics - ETH Zurich" ;
    pulse:ror "https://ror.org/05a28qc87" ;
    pulse:hasOrganizationProfile [ a pulse:OrganizationProfile ; pulse:platform pulse:GitHub ; pulse:organizationHandle "eth-physics" ] ;
    pulse:OrganizationType pulse:University ;
    pulse:githubOrgFollowers "125"^^xsd:integer ;
    org:hasUnit pulse:PhysicsSimulationUnit .

# Organization 4: Physics Simulation Unit (subunit)
pulse:PhysicsSimulationUnit a org:Organization ;
    pulse:hasOrganizationProfile [ a pulse:OrganizationProfile ; pulse:platform pulse:GitHub ; pulse:organizationHandle "physics-sim" ] ;
    schema:name "Physics Simulation Unit" ;
    org:unitOf pulse:DepartmentPhysics ;
    pulse:owns pulse:SimulationFramework .

