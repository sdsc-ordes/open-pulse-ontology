@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
wd:Q395 a pulse:DisciplineEnumeration .
pulse:Software a pulse:RepositoryTypeEnumeration .

# INVALID REPOSITORY - Should FAIL validation
# pulse:relatedToEPFL must be an xsd:boolean literal, not a string

pulse:InvalidRelatedToEPFLRepo a schema:SoftwareSourceCode ;
    schema:name "RelatedToEPFL Wrong Datatype" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/example/invalid-related-to-epfl> ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:creator pulse:AuthorBadFlag ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q395 ;
    pulse:relatedToEPFL "yes" .  # wrong datatype, should be boolean

pulse:AuthorBadFlag a schema:Person ;
    schema:name "Nina Flag" ;
    schema:email "nina@example.com" ;
    pulse:gitUsername "ninaflag" .
