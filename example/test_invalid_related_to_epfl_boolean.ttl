@prefix schema: <http://schema.org/> .
@prefix ex: <http://example.org/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
wd:Q395 a ex:DisciplineEnumeration .
ex:Software a ex:RepositoryTypeEnumeration .

# INVALID REPOSITORY - Should FAIL validation
# ex:relatedToEPFL must be an xsd:boolean literal, not a string

ex:InvalidRelatedToEPFLRepo a schema:SoftwareSourceCode ;
    schema:name "RelatedToEPFL Wrong Datatype" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/example/invalid-related-to-epfl> ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:creator ex:AuthorBadFlag ;
    ex:repositoryType ex:Software ;
    ex:discipline wd:Q395 ;
    ex:relatedToEPFL "yes" .  # wrong datatype, should be boolean

ex:AuthorBadFlag a schema:Person ;
    schema:name "Nina Flag" ;
    schema:email "nina@example.com" ;
    ex:gitUsername "ninaflag" .
