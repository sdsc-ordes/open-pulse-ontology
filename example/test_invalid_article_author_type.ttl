@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration .

# INVALID ARTICLE AUTHOR TYPE - Should FAIL (schema:author must be a schema:Person)

pulse:InvalidArticle a schema:ScholarlyArticle ;
    schema:name "Article With Org Author" ;
    pulse:doi "10.1234/invalid.author" ;
    schema:datePublished "2024-05-15"^^xsd:date ;
    schema:author pulse:OrgAuthor ;   # invalid type
    schema:sourceOrganization pulse:OrgAuthor .

pulse:OrgAuthor a org:Organization ;
    schema:name "Publishing Org" ;
    pulse:ror "https://ror.org/02s376052" ;
    pulse:githubOrganizationHandle "publishing-org" ;
    pulse:OrganizationType pulse:ResearchInstitution .