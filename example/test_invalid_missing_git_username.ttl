@prefix schema: <http://schema.org/> .
@prefix ex: <http://example.org/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
wd:Q395 a ex:DisciplineEnumeration .
ex:Software a ex:RepositoryTypeEnumeration .

# INVALID PERSON - Should FAIL validation
# Missing required git username, ex:GitUsernameShape has sh:minCount 1

ex:InvalidMissingGitUsernameRepo a schema:SoftwareSourceCode ;
    schema:name "Missing Git Username Test" ;
    schema:dateCreated "2024-01-15T10:30:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/example/invalid-git-username> ;
    schema:license <https://spdx.org/licenses/MIT.html> ;
    schema:citation <https://doi.org/10.1234/example.citation> ;
    schema:creator ex:PersonMissingGitUsername ;
    ex:repositoryType ex:Software ;
    ex:discipline wd:Q395 . 

ex:PersonMissingGitUsername a schema:Person ;
    schema:name "George NoUsername" ;
    schema:email "george@example.com" .