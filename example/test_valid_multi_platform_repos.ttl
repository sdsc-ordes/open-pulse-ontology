@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
pulse:Software a pulse:RepositoryTypeEnumeration .
pulse:GitHub a pulse:PlatformEnumeration .
pulse:GitLab a pulse:PlatformEnumeration .
pulse:Bitbucket a pulse:PlatformEnumeration .
wd:Q395 a pulse:DisciplineEnumeration .

# VALID MULTI-PLATFORM REPOSITORIES - Should PASS validation
# Demonstrates that a repository can live on GitHub, GitLab (including nested
# groups/subgroups), or Bitbucket, distinguished by the required pulse:platform.

pulse:GitHubRepo a schema:SoftwareSourceCode ;
    schema:name "GitHub-hosted Tool" ;
    schema:dateCreated "2024-01-10T09:00:00"^^xsd:dateTime ;
    pulse:repositoryHandle "open-pulse/example-tool" ;
    pulse:platform pulse:GitHub ;
    schema:author pulse:MultiPlatformAuthor ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q395 .

pulse:GitLabRepo a schema:SoftwareSourceCode ;
    schema:name "GitLab-hosted Tool" ;
    schema:dateCreated "2024-02-15T09:00:00"^^xsd:dateTime ;
    pulse:repositoryHandle "epfl-group/subgroup/example-tool" ;
    pulse:platform pulse:GitLab ;
    schema:author pulse:MultiPlatformAuthor ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q395 .

pulse:BitbucketRepo a schema:SoftwareSourceCode ;
    schema:name "Bitbucket-hosted Tool" ;
    schema:dateCreated "2024-03-20T09:00:00"^^xsd:dateTime ;
    pulse:repositoryHandle "open-pulse-workspace/example-tool" ;
    pulse:platform pulse:Bitbucket ;
    schema:author pulse:MultiPlatformAuthor ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q395 .

pulse:MultiPlatformAuthor a schema:Person ;
    schema:name "Priya Sharma" ;
    pulse:orcidIdentifier "0000-0005-6789-1234" .
