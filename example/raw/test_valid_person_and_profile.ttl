    pulse:hasExternalIdentifier pulse:AdaScopusId ;
    pulse:hasProfile pulse:AdaGitHubProfile .

pulse:AdaScopusId a pulse:ExternalIdentifier ;
    pulse:identifierScheme pulse:Scopus ;
    schema:identifier "57200000000" .

