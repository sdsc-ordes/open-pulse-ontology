@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pulse:GitHub a pulse:PlatformEnumeration .
pulse:Scopus a pulse:IdentifierSchemeEnumeration .

# VALID - verbose PersonShape and PlatformProfileShape additions.

pulse:AdaResearcher a schema:Person ;
