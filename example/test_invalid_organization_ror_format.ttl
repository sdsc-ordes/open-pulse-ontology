@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
pulse:Software a pulse:RepositoryTypeEnumeration .
pulse:ResearchInstitution a pulse:OrganizationTypeEnumeration .
wd:Q8008 a pulse:DisciplineEnumeration .
pulse:GitHub a pulse:PlatformEnumeration .

# INVALID ROR IDENTIFIER - Should FAIL (does not match https://ror.org/[0-9a-z]{9})

pulse:BadRORRepo a schema:SoftwareSourceCode ;
    schema:name "Bad ROR Repo" ;
    schema:dateCreated "2024-06-20T12:00:00"^^xsd:dateTime ;
    pulse:githubRepositoryHandle "example/bad-ror" ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:citation <https://doi.org/10.1234/example.badror> ;
    schema:author pulse:RORAuthor ;
    pulse:ownedBy pulse:BadROROrg ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q8008 .

pulse:RORAuthor a schema:Person ;
    schema:name "ROR Test Author" ;
    pulse:orcidIdentifier "0000-0003-1234-5678" ;
    pulse:hasProfile pulse:RORAuthorGitHubProfile .

pulse:RORAuthorGitHubProfile a pulse:PlatformProfile ;
    pulse:platform pulse:GitHub ;
    pulse:githubUsername "rorauthor" ;
    schema:email "ror@example.com" .

pulse:BadROROrg a org:Organization ;
    schema:name "Org With Bad ROR" ;
    pulse:ror "https://ror.org/01234" ;  # invalid: only 5 characters, should be 9
    pulse:githubOrganizationHandle "example-bad-ror" ;
    pulse:OrganizationType pulse:ResearchInstitution .
