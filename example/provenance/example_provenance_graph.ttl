@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ILLUSTRATIVE ONLY — not run by test_validation.py. The file as a
# whole isn't parseable by this repo's tooling, since rdflib 7.6.0
# cannot parse the Turtle-star `<<...>>` syntax used below for the
# winner-link (confirmed: `<<` is read as a broken URI, not a quoted
# triple) — that part has no SHACL shapes either, and can't. The
# ExtractionRun/ExtractionOutput/SoftwareAgent parts below ARE shaped
# and separately tested (see example/provenance/test_valid_extraction_run.ttl
# and example/raw/test_valid_extraction_output.ttl); they're repeated
# here just to show the full picture in one place.
#
# Made-up scenario, no correspondence to any real person: one overall
# run hit two platforms, each producing its own ExtractionOutput (its
# own raw graph). The unifier merged the two resulting provisional
# profiles into canonical :Jordan, and had to pick a winning
# schema:name — GitHub's spelling ("Jordan Reyes") was chosen over
# Infoscience's abbreviated form ("J. Reyes"), a normalized/contested
# pick, exactly the case graph:prov exists for, since matching the
# winning object value alone could never recover which source it came
# from.

# This graph is itself a prov:Bundle: its content is provenance
# descriptions (the wasDerivedFrom winner-link below), not domain data.
<graph:prov> a prov:Bundle .

pulse:Run2026W01 a pulse:ExtractionRun ;
    prov:startedAtTime "2026-01-05T02:00:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-01-05T02:14:00"^^xsd:dateTime ;
    pulse:extractionSeed "sdsc-ordes/open-pulse-ontology" ;
    pulse:extractedBy pulse:GitMetadataExtractor2_3_1 .

pulse:GitMetadataExtractor2_3_1 a prov:SoftwareAgent ;
    schema:name "git-metadata-extractor" ;
    schema:softwareVersion "2.3.1" .

# Two sibling outputs from that one run — connected by sharing the
# same prov:wasGeneratedBy target, not by nesting prov:Bundle.
<raw:run2026w01-github> a pulse:ExtractionOutput ;
    prov:wasGeneratedBy pulse:Run2026W01 ;
    pulse:platform pulse:GitHub ;
    prov:generatedAtTime "2026-01-05T02:07:00"^^xsd:dateTime .

<raw:run2026w01-infoscience> a pulse:ExtractionOutput ;
    prov:wasGeneratedBy pulse:Run2026W01 ;
    pulse:platform pulse:Infoscience ;
    prov:generatedAtTime "2026-01-05T02:14:00"^^xsd:dateTime .

# The winning triple `pulse:Jordan schema:name "Jordan Reyes"` lives in
# graph:canonical. This is its provenance record, in graph:prov —
# pointing at the specific ExtractionOutput it was read from, not the
# overall ExtractionRun:
<< pulse:Jordan schema:name "Jordan Reyes" >>
    prov:wasDerivedFrom <raw:run2026w01-github> ;
    pulse:observationKind "highest-confidence" ;
    pulse:observationConfidence "0.9"^^xsd:decimal ;
    pulse:observedOn "2026-01-05T02:10:00"^^xsd:dateTime ;
    pulse:firstObservedOn "2025-11-01T00:00:00"^^xsd:dateTime ;
    pulse:lastConfirmedOn "2026-01-05T02:10:00"^^xsd:dateTime ;
    pulse:observationCount 4 .

# The two provisional Person profiles the unifier merged into :Jordan —
# plain triples, not RDF-star annotations:
pulse:GitHubJordanProfilePerson pulse:samePersonAs pulse:Jordan .
pulse:InfoscienceJordanProfilePerson pulse:samePersonAs pulse:Jordan .
