@prefix schema: <http://schema.org/> .
@prefix pulse: <https://open-pulse.epfl.ch/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
pulse:Software a pulse:RepositoryTypeEnumeration .
wd:Q413 a pulse:DisciplineEnumeration .

# INVALID LICENSE/CITATION NODEKIND - Should FAIL (must be IRIs, not literals)

pulse:InvalidLicenseCitationRepo a schema:SoftwareSourceCode ;
    schema:name "Literal License/Citation Repo" ;
    schema:dateCreated "2024-04-01T09:00:00"^^xsd:dateTime ;
    schema:codeRepository <https://github.com/example/literal-license> ;
    schema:license "MIT" ;             # invalid: expected IRI
    schema:citation "10.1000/foo" ;    # invalid: expected IRI
    schema:creator pulse:LiteralAuthor ;
    pulse:repositoryType pulse:Software ;
    pulse:discipline wd:Q413 ;
    pulse:relatedToEPFL false .

pulse:LiteralAuthor a schema:Person ;
    schema:name "Casey Literal" ;
    schema:email "casey.literal@example.com" ;
    pulse:gitUsername "cliteral" .
